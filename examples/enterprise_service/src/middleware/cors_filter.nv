# Middleware Layer: Cross-Origin Resource Sharing (CORS) Security Filter
# Module: middleware.cors_filter

type CorsConfig = struct:
    allowed_origins: String
    allowed_methods: String
    allowed_headers: String
    allow_credentials: Bool

pub fn make_default_cors_config() -> CorsConfig:
    CorsConfig {
        allowed_origins: "https://cloud.novasystems.dev",
        allowed_methods: "GET, POST, PUT, DELETE, OPTIONS",
        allowed_headers: "Authorization, Content-Type, X-Request-ID, Idempotency-Key",
        allow_credentials: true
    }

pub fn cors_filter_is_allowed(origin: String, cfg: CorsConfig) -> Bool:
    if origin == cfg.allowed_origins:
        true
    elif origin == "https://localhost:8443":
        true
    else:
        false
