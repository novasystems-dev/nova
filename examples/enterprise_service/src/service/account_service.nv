# Service Layer: Account Lifecycle & Balance Query Service
# Module: service.account_service

import models.account { Account }
import repository.account_repo { account_repo_find_by_id, account_repo_check_balance, account_repo_is_active }
import dto.account_dto { AccountSummaryResponse, make_account_summary }

pub fn account_service_get_summary(acc_id: Int) -> AccountSummaryResponse:
    let acc = account_repo_find_by_id(acc_id)
    let is_ok = account_repo_is_active(acc_id)
    make_account_summary(acc.account_id, acc.account_number, acc.currency, acc.balance_cents, is_ok)

pub fn account_service_has_sufficient_funds(acc_id: Int, amount_cents: Int) -> Bool:
    let bal = account_repo_check_balance(acc_id)
    if bal >= amount_cents:
        true
    else:
        false
