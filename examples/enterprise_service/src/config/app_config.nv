# Config Layer: Application Server Configuration
# Module: config.app_config

type AppConfig = struct:
    server_port: Int
    environment: String
    workers_count: Int
    request_timeout_ms: Int
    max_payload_bytes: Int

pub fn make_default_app_config() -> AppConfig:
    AppConfig {
        server_port: 8443,
        environment: "production",
        workers_count: 16,
        request_timeout_ms: 5000,
        max_payload_bytes: 10485760
    }

pub fn make_dev_app_config() -> AppConfig:
    AppConfig {
        server_port: 8080,
        environment: "development",
        workers_count: 4,
        request_timeout_ms: 30000,
        max_payload_bytes: 52428800
    }
