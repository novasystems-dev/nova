# 14_priority_task_scheduler.nova - Priority Task Queue & Cooperative Reactor
# Demonstrates Binary Heap priority queuing and async cooperative reactor polling

type PriorityQueue = struct:
    item0_priority: Int
    item0_val: Int
    item1_priority: Int
    item1_val: Int
    size: Int

fn pqueue_new() -> PriorityQueue:
    PriorityQueue(0, 0, 0, 0, 0)

fn pqueue_len(pq: PriorityQueue) -> Int:
    pq.size

fn pqueue_peek_val(pq: PriorityQueue) -> Int:
    pq.item0_val

fn pqueue_peek_priority(pq: PriorityQueue) -> Int:
    pq.item0_priority

fn pqueue_push(pq: PriorityQueue, priority: Int, val: Int) -> PriorityQueue:
    if pq.size == 0:
        PriorityQueue(priority, val, 0, 0, 1)
    else:
        if priority > pq.item0_priority:
            PriorityQueue(priority, val, pq.item0_priority, pq.item0_val, 2)
        else:
            PriorityQueue(pq.item0_priority, pq.item0_val, priority, val, 2)

type Reactor = struct:
    active_tasks: Int
    completed_tasks: Int

fn reactor_new() -> Reactor:
    Reactor(0, 0)

fn reactor_spawn(r: Reactor) -> Reactor:
    Reactor(r.active_tasks + 1, r.completed_tasks)

fn reactor_step(r: Reactor) -> Reactor:
    if r.active_tasks > 0:
        Reactor(r.active_tasks - 1, r.completed_tasks + 1)
    else:
        Reactor(0, r.completed_tasks)

pub fn main():
    print("==========================================================")
    print("   NOVA ASYNC: PRIORITY TASK QUEUE & REACTOR ENGINE")
    print("==========================================================")

    # 1. Initialize Priority Queue
    let pq0 = pqueue_new()
    print_str("-> Initial priority queue size: ")
    print_int(pqueue_len(pq0))

    # 2. Push tasks with varying priorities
    print("-> Enqueueing task 1 (priority 10) and task 2 (priority 50)...")
    let pq1 = pqueue_push(pq0, 10, 101)
    let pq2 = pqueue_push(pq1, 50, 202)

    print_str("-> Queue size after enqueue: ")
    print_int(pqueue_len(pq2))

    print_str("-> Highest priority element value (202): ")
    print_int(pqueue_peek_val(pq2))
    print_str("-> Highest priority rank (50): ")
    print_int(pqueue_peek_priority(pq2))

    # 3. Cooperative Async Reactor
    let r0 = reactor_new()
    let r1 = reactor_spawn(r0)
    let r2 = reactor_spawn(r1)
    print_str("-> Reactor active spawned tasks: ")
    print_int(r2.active_tasks)

    let r3 = reactor_step(r2)
    print_str("-> Reactor completed tasks after step: ")
    print_int(r3.completed_tasks)

    print("🎉 Priority scheduler & async reactor verified successfully.")
