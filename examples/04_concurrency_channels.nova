# 04_concurrency_channels.nova - Zero Data Race & Deadlock-Free Concurrency

import std.concurrency { Channel, spawn }

type WorkItem = struct:
    id: Int
    payload: String

# Channel receives isolated reference: exactly one owner exists
pub fn worker(rx: Channel[iso WorkItem]):
    while let Some(item) = rx.recv():
        print("Processing task:")
        print(item.payload)

pub fn main():
    let (tx, rx) = Channel[iso WorkItem].create()
    
    # Spawn worker thread
    spawn(fn() => worker(rx))
    
    # Create isolated instances
    let task1 = iso WorkItem { id: 1, payload: "Mathematical computation" }
    let task2 = iso WorkItem { id: 2, payload: "Database synchronization" }
    
    # Send moves ownership across threads with zero copy
    tx.send(task1)
    tx.send(task2)
    tx.close()
