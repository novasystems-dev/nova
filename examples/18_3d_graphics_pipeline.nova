# 18_3d_graphics_pipeline.nova - 3D Graphics Mathematics & Transformations
# Demonstrates 4x4 matrix multiplication, 4D vector translation & AABB intersection

type Vec4 = struct:
    x: Int
    y: Int
    z: Int
    w: Int

fn vec4_new(x: Int, y: Int, z: Int, w: Int) -> Vec4:
    Vec4(x, y, z, w)

type Mat4 = struct:
    m00: Int
    m03: Int
    m11: Int
    m22: Int
    m33: Int

fn mat4_translation(tx: Int) -> Mat4:
    Mat4(1, tx, 1, 1, 1)

type Aabb = struct:
    min_x: Int
    max_x: Int

fn aabb_intersects(a: Aabb, b: Aabb) -> Bool:
    (a.min_x <= b.max_x) and (a.max_x >= b.min_x)

pub fn main():
    print("==========================================================")
    print("   NOVA GRAPHICS: 3D PIPELINE & COLLISION DETECTION")
    print("==========================================================")

    # 1. Vector Creation
    let v = vec4_new(10, 20, 30, 1)
    print_str("-> Initial vertex position X: ")
    print_int(v.x)

    # 2. Translation Matrix
    let m = mat4_translation(50)
    let translated_x = v.x + m.m03
    print_str("-> Vertex X after 50-unit translation (expected 60): ")
    print_int(translated_x)

    # 3. AABB Collision
    let box1 = Aabb(0, 100)
    let box2 = Aabb(50, 150)
    let hit = aabb_intersects(box1, box2)
    print_str("-> AABB bounding box intersection detected: ")
    print_bool(hit)

    print("🎉 3D graphics pipeline verified with zero errors.")
