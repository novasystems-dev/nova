# 03_perceus_tree.nova - Binary Search Tree with Perceus In-Place Reuse

type Tree = enum:
    Leaf
    Node(val: Int, left: Tree, right: Tree)

# Under Perceus analysis: If tree `t` has a reference count of 1,
# insert mutates the existing node directly without malloc/free calls.
pub fn insert(t: Tree, v: Int) -> Tree:
    match t:
        Leaf =>
            Node(v, Leaf, Leaf)
        Node(val, left, right) =>
            if v < val:
                Node(val, insert(left, v), right)
            else:
                Node(val, left, insert(right, v))

pub fn main():
    let mut root = Tree.Leaf
    for i in [5, 2, 8, 1, 9]:
        root = insert(root, i)
    print("Binary search tree constructed with optimal allocation reuse.")
