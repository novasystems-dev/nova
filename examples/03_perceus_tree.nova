# 03_perceus_tree.nova - Cấu trúc Dữ liệu Cây Nhị Phân với Tối ưu hóa Bộ nhớ Perceus

type Tree = enum:
    Leaf
    Node(val: Int, left: Tree, right: Tree)

# Nhờ cơ chế Perceus: Nếu cây t chỉ có 1 tham chiếu duy nhất (RC == 1),
# hàm insert sẽ ghi đè trực tiếp lên ô nhớ của Node cũ mà không cần malloc/free!
pub fn insert(t: Tree, v: Int) -> Tree:
    match t:
        Leaf =>
            Node(v, Leaf, Leaf)
        Node(val, left, right) =>
            if v < val:
                Node(val, insert(left, v), right)
            else:
                Node(val, left, insert(right, v))

pub fn main():
    let mut root = Tree.Leaf
    for i in [5, 2, 8, 1, 9]:
        root = insert(root, i)
    print("Cây nhị phân đã khởi tạo thành công với chi phí cấp phát tối ưu!")
