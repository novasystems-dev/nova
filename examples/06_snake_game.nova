# 06_snake_game.nova - Terminal Snake Game written in Nova
# Features:
# - Autonomous AI pathfinding hunting food across a 16x8 grid
# - Frame rendering with ANSI clear screen, borders, snake body, and food
# - Real-time animation loop with score tracking and collision detection

type SnakeGame = struct:
    head_x: Int
    head_y: Int
    b1_x: Int
    b1_y: Int
    b2_x: Int
    b2_y: Int
    b3_x: Int
    b3_y: Int
    food_x: Int
    food_y: Int
    dir_x: Int
    dir_y: Int
    score: Int
    step: Int
    alive: Bool

fn init_game() -> SnakeGame:
    SnakeGame(4, 3, 3, 3, 2, 3, 1, 3, 11, 4, 1, 0, 0, 0, true)

fn update_ai_direction(g: SnakeGame) -> SnakeGame:
    let mut dx = 0
    let mut dy = 0
    if g.head_x < g.food_x:
        dx = 1
        dy = 0
    elif g.head_x > g.food_x:
        dx = 0 - 1
        dy = 0
    elif g.head_y < g.food_y:
        dx = 0
        dy = 1
    else:
        dx = 0
        dy = 0 - 1
    SnakeGame(g.head_x, g.head_y, g.b1_x, g.b1_y, g.b2_x, g.b2_y, g.b3_x, g.b3_y, g.food_x, g.food_y, dx, dy, g.score, g.step, g.alive)

fn step_game(g: SnakeGame) -> SnakeGame:
    let next_x = g.head_x + g.dir_x
    let next_y = g.head_y + g.dir_y
    if next_x <= 0 or next_x >= 15 or next_y <= 0 or next_y >= 7:
        SnakeGame(g.head_x, g.head_y, g.b1_x, g.b1_y, g.b2_x, g.b2_y, g.b3_x, g.b3_y, g.food_x, g.food_y, g.dir_x, g.dir_y, g.score, g.step + 1, false)
    else:
        let ate_food = next_x == g.food_x and next_y == g.food_y
        let mut new_score = g.score
        let mut new_food_x = g.food_x
        let mut new_food_y = g.food_y
        if ate_food:
            new_score = g.score + 10
            if g.food_x == 11:
                new_food_x = 4
                new_food_y = 2
            elif g.food_x == 4:
                new_food_x = 12
                new_food_y = 5
            else:
                new_food_x = 7
                new_food_y = 3
        SnakeGame(next_x, next_y, g.head_x, g.head_y, g.b1_x, g.b1_y, g.b2_x, g.b2_y, new_food_x, new_food_y, g.dir_x, g.dir_y, new_score, g.step + 1, true)

fn render(g: SnakeGame):
    clear_screen()
    print("========================================")
    print("  NOVA TERMINAL SNAKE GAME (v0.1.0)")
    print("========================================")
    let mut y = 0
    while y < 8:
        let mut x = 0
        while x < 16:
            if x == 0 or x == 15 or y == 0 or y == 7:
                print_str("#")
            elif x == g.head_x and y == g.head_y:
                print_str("@")
            elif x == g.b1_x and y == g.b1_y:
                print_str("o")
            elif x == g.b2_x and y == g.b2_y:
                print_str("o")
            elif x == g.b3_x and y == g.b3_y:
                print_str("o")
            elif x == g.food_x and y == g.food_y:
                print_str("*")
            else:
                print_str(" ")
            x = x + 1
        print("")
        y = y + 1
    print("----------------------------------------")
    print_str("Score: ")
    print_int(g.score)
    print_str(" | Step: ")
    print_int(g.step)
    if g.alive:
        print(" | Status: HUNTING")
    else:
        print(" | Status: GAME OVER")
    print("========================================")

pub fn main():
    hide_cursor()
    let mut game = init_game()
    let mut frame = 0
    while frame < 20 and game.alive:
        game = update_ai_direction(game)
        game = step_game(game)
        render(game)
        sleep_ms(150)
        frame = frame + 1
    show_cursor()
    print("Game session finished. Hope you enjoyed playing Nova Snake!")
