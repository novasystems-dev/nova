# ============================================================================
# Example 24: Real-Time WAV PCM Audio Synthesizer in Pure Nova
# Nova Systems Programming Language (v0.31.00)
# ============================================================================

type WavHeader = struct:
    channels: Int
    sample_rate: Int
    bits_per_sample: Int
    byte_rate: Int
    data_size: Int

fn wav_header_stereo(total_samples: Int) -> WavHeader:
    let ch = 2
    let rate = 44100
    let bits = 16
    let byte_rate = 176400
    let size = total_samples * 4
    WavHeader(ch, rate, bits, byte_rate, size)

fn wav_synth_sine(sample_idx: Int, freq_hz: Int) -> Int:
    let phase = (sample_idx * freq_hz) % 44100
    if phase < 22050:
        16000
    else:
        0 - 16000

fn main():
    print("==========================================================")
    print("  EXAMPLE 24: Real-Time PCM 16-Bit Audio Synthesizer")
    print("==========================================================")

    let hdr = wav_header_stereo(44100)
    print("-> Generated RIFF WAV Audio Header (1 Second Stereo):")
    print_str("   Sample Rate: ")
    print_int(hdr.sample_rate)
    print_str(" Hz | Channels: ")
    print_int(hdr.channels)
    print_newline()
    print_str("   Bit Depth: ")
    print_int(hdr.bits_per_sample)
    print_str("-bit | Buffer Size: ")
    print_int(hdr.data_size)
    print_str(" bytes\n")

    let s0 = wav_synth_sine(10, 440)
    let s1 = wav_synth_sine(22000, 440)
    print_str("-> Synthesized 440Hz Sine Waveform (Sample #10): ")
    print_int(s0)
    print_newline()
    print_str("-> Synthesized 440Hz Sine Waveform (Sample #22000): ")
    print_int(s1)
    print_newline()
    print("✅ PCM Audio synthesis verified.")
