# 02_refinements_z3.nova - Minh họa Hệ thống Kiểu Tinh Chỉnh (Refinement Types & SMT Z3)

# 1. Định nghĩa kiểu số nguyên dương và khác 0
type Nat = n: Int where n >= 0
type NonZero = n: Int where n != 0
type Percentage = p: Int where p >= 0 and p <= 100

# 2. Phép chia an toàn tuyệt đối: Z3 chứng minh mẫu số != 0 ngay lúc biên dịch
pub fn safe_divide(numerator: Int, denominator: NonZero) -> Int:
    return numerator / denominator

# 3. Truy cập mảng an toàn tuyệt đối: Không sợ Out of Bounds
pub fn safe_get_first[T](arr: [T] where len(arr) > 0) -> T:
    return arr[0] # Trình biên dịch gỡ bỏ hoàn toàn lệnh bounds check runtime!

pub fn calculate_discount(price: Nat, discount: Percentage) -> Nat:
    # Z3 tự động chứng minh: price * (100 - discount) / 100 luôn >= 0 và mẫu số 100 != 0
    let factor = 100 - discount
    let final_price = (price * factor) / 100
    return final_price

pub fn main():
    let price = 500
    let discount = 20
    let final_price = calculate_discount(price, discount)
    print("Giá sau giảm: {final_price}")
