# 02_refinements_z3.nova - Refinement Types and SMT Verification

# 1. Refined integer types
type Nat = n: Int where n >= 0
type NonZero = n: Int where n != 0
type Percentage = p: Int where p >= 0 and p <= 100

# 2. Provably safe division: Z3 proves denominator != 0 at compile time
pub fn safe_divide(numerator: Int, denominator: NonZero) -> Int:
    return numerator / denominator

# 3. Provably safe array access: zero runtime bounds checks needed
pub fn safe_first[T](arr: [T] where len(arr) > 0) -> T:
    return arr[0]

pub fn calculate_discount(price: Nat, discount: Percentage) -> Nat:
    # Z3 verifies factor >= 0, and division by 100 is non-zero
    let factor = 100 - discount
    let final_price = (price * factor) / 100
    return final_price

pub fn main():
    let price = 500
    let discount = 20
    let final_price = calculate_discount(price, discount)
    print("Discounted price (500 with 20% discount):")
    print_int(final_price)
