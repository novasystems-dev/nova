# ============================================================================
# Example 21: Direct WebAssembly (WAT) Code Generation in Pure Nova
# Nova Systems Programming Language (v0.31.00)
# ============================================================================

type WasmValType = struct:
    tag: Int
    name: String

fn wasm_type_i32() -> WasmValType:
    WasmValType(127, "i32")

fn wasm_opcode_name(op: Int) -> String:
    if op == 0:
        "unreachable"
    elif op == 106:
        "i32.add"
    elif op == 107:
        "i32.sub"
    elif op == 108:
        "i32.mul"
    else:
        "unknown"

type WasmFunction = struct:
    name: String
    param_count: Int
    return_type: String

fn wasm_fn_new(name: String, params: Int, ret: String) -> WasmFunction:
    WasmFunction(name, params, ret)

fn main():
    print("==========================================================")
    print("  EXAMPLE 21: Direct WebAssembly (WAT) Bytecode Emitter")
    print("==========================================================")

    let t_i32 = wasm_type_i32()
    print_str("-> Wasm Value Type: ")
    print(t_i32.name)
    print_str("-> Wasm Opcode [106]: ")
    print(wasm_opcode_name(106))

    let fn_add = wasm_fn_new("add_telemetry", 2, "i32")
    if fn_add.param_count >= 0:
        print("-> Emitting WebAssembly Text Format (WAT) Function:")
        print_str("(module\n")
        print_str("  (memory (export \"memory\") 1)\n")
        print_str("  (func (export \"")
        print_str(fn_add.name)
        print_str("\") (result ")
        print_str(fn_add.return_type)
        print_str(")\n")
        print_str("    i32.const 42\n")
        print_str("    i32.add\n")
        print_str("  )\n")
        print_str(")\n")
        print("✅ Direct WebAssembly module generated successfully.")
