# 07_network_http_server.nova - High-Performance Native HTTP Server in Nova
# Demonstrates:
# - Low-level POSIX TCP socket networking (listen, accept, send_response)
# - Systems-level bitwise operations for routing and status flags (<<, |, &)
# - Zero-cost abstractions and sub-millisecond response latency with zero GC

# Bitwise Route & Method Flags
type ServerConfig = struct:
    port: Int
    max_requests: Int
    route_mask: Int

fn init_server(port: Int, max_requests: Int) -> ServerConfig:
    let flag_get = 1 << 0
    let flag_post = 1 << 1
    let flag_metrics = 1 << 2
    let combined_mask = flag_get | flag_post | flag_metrics
    ServerConfig(port, max_requests, combined_mask)

fn route_request(client_fd: Int, request_count: Int):
    let body = "Hello from Nova Systems Programming Engine!\nStatus: 200 OK | Zero-GC Perceus Memory | Native C99/LLVM Backend\n"
    tcp_send_response(client_fd, "200 OK", body)

pub fn main():
    print("==========================================================")
    print("  NOVA HIGH-PERFORMANCE NATIVE HTTP SERVER (v0.1.0)")
    print("==========================================================")
    let config = init_server(8080, 5)
    print_str("-> Initializing TCP listener on port: ")
    print_int(config.port)
    print("")

    let server_fd = tcp_listen(config.port)
    if server_fd < 0:
        print("Error: Failed to bind TCP socket on port 8080")
    else:
        print("-> Socket bound successfully. Listening for incoming connections...")
        print("-> Test with: curl -i http://127.0.0.1:8080/")
        let mut handled = 0
        while handled < config.max_requests:
            let client_fd = tcp_accept(server_fd)
            if client_fd >= 0:
                handled = handled + 1
                print_str("[HTTP Server] Connection accepted. Dispatching request #")
                print_int(handled)
                print("")
                route_request(client_fd, handled)
        tcp_close(server_fd)
        print("----------------------------------------------------------")
        print("-> Server handled maximum scheduled requests. Socket closed cleanly.")
