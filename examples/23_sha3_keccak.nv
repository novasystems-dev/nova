# ============================================================================
# Example 23: SHA-3 / Keccak-256 Sponge Function in Pure Nova
# Nova Systems Programming Language (v0.31.02)
# ============================================================================

type KeccakState = struct:
    s0: Int
    s1: Int
    s2: Int
    s3: Int
    round: Int

fn keccak_state_new() -> KeccakState:
    KeccakState(0, 0, 0, 0, 0)

fn keccak_absorb(s: KeccakState, data: Int) -> KeccakState:
    let n0 = s.s0 ^ data
    let n1 = s.s1 ^ ((data << 1) | (data >> 31))
    KeccakState(n0, n1, s.s2, s.s3, s.round + 1)

fn main():
    print("==========================================================")
    print("  EXAMPLE 23: SHA-3 / Keccak-256 Sponge Function")
    print("==========================================================")

    let s0 = keccak_state_new()
    print("-> Initial Keccak Sponge State (all lanes zero): OK")

    let s1 = keccak_absorb(s0, 305419896)
    let s2 = keccak_absorb(s1, 1604569098)

    print_str("-> Absorbed Rate Block 1 (Lane 0): ")
    print_int(s1.s0)
    print_newline()
    print_str("-> Absorbed Rate Block 2 (Rounds): ")
    print_int(s2.round)
    print_newline()
    print("✅ SHA-3 / Keccak-256 state transformation complete.")
