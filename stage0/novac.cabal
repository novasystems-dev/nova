cabal-version:      3.0
name:               novac
version:            0.1.0.0
synopsis:           Genesis Stage-0 Compiler for the Nova Programming Language
description:        Bootstrap compiler for Nova written in Haskell, targeting C99 and LLVM IR.
license:            Apache-2.0
author:             Nova Language Team
maintainer:         core@novalang.org
build-type:         Simple

common common-options
    default-language:   GHC2021
    ghc-options:        -Wall
                        -Wcompat
                        -Widentities
                        -Wincomplete-record-updates
                        -Wincomplete-uni-patterns
                        -Wpartial-fields
                        -Wredundant-constraints
                        -fhide-source-paths
    default-extensions:
        OverloadedStrings
        DeriveGeneric
        DerivingStrategies
        LambdaCase
        RecordWildCards

library
    import:             common-options
    hs-source-dirs:     src
    exposed-modules:
        Nova.Syntax.Span
        Nova.Syntax.Token
        Nova.Syntax.AST
        Nova.Parser.Lexer
        Nova.Parser.Indent
        Nova.Parser.Parser
        Nova.Diagnostic.Report
        Nova.Typecheck.Checker
        Nova.Codegen.C99
    build-depends:
        base >= 4.17 && < 5,
        text >= 2.0,
        containers >= 0.6,
        megaparsec >= 9.5,
        parser-combinators >= 1.3,
        mtl >= 2.3,
        prettyprinter >= 1.7,
        prettyprinter-ansi-terminal >= 1.1,
        process >= 1.6,
        filepath >= 1.4

executable novac
    import:             common-options
    main-is:            Main.hs
    hs-source-dirs:     app
    build-depends:
        base,
        novac,
        text,
        containers,
        filepath,
        directory,
        process
