# ============================================================================
# Unit Test: WebAssembly Generation & Type Tables
# Nova Systems Programming Language (v0.31.02)
# ============================================================================

type WasmValType = struct:
    tag: Int
    name: String

fn wasm_type_i32() -> WasmValType:
    WasmValType(127, "i32")

fn wasm_type_i64() -> WasmValType:
    WasmValType(126, "i64")

fn wasm_opcode_name(op: Int) -> String:
    if op == 106:
        "i32.add"
    elif op == 107:
        "i32.sub"
    else:
        "other"

fn main():
    print("--- Running Test: WebAssembly Specification Tables ---")
    let t32 = wasm_type_i32()
    let t64 = wasm_type_i64()
    
    if t32.tag == 127:
        print("   [OK] i32 wasm type tag matches 0x7F")
        
    if t64.tag == 126:
        print("   [OK] i64 wasm type tag matches 0x7E")
        
    if str_eq(wasm_opcode_name(106), "i32.add"):
        print("   [OK] wasm opcode 106 maps to i32.add")
        
    print("TEST WASM SPECIFICATION PASSED: 3/3 checks verified.")
