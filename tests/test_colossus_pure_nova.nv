type Win32Handle = struct:
    handle_val: Int
    is_valid: Bool

pub fn win32_make_handle(val: Int) -> Win32Handle:
    if val != 0 and val != (0 - 1):
        Win32Handle(val, true)
    else:
        Win32Handle(val, false)

type Win32MemoryPage = struct:
    base_address: Int
    size_bytes: Int
    is_committed: Bool

pub fn win32_alloc_virtual(size_bytes: Int) -> Win32MemoryPage:
    let rem = size_bytes % 65536
    if rem == 0:
        let base_addr = 536870912 + (size_bytes % 16777216)
        Win32MemoryPage(base_addr, size_bytes, true)
    else:
        let aligned = (size_bytes / 65536 + 1) * 65536
        let base_addr = 536870912 + (aligned % 16777216)
        Win32MemoryPage(base_addr, aligned, true)

pub fn win32_free_virtual(page: Win32MemoryPage) -> Bool:
    page.base_address != 0 and page.size_bytes > 0

type Win32ThreadContext = struct:
    thread_id: Int
