# 1. Test Linux Syscall & Page Subsystem
fn test_linux_subsystem():
    print_str("-> [Pure Nova] Testing Linux x86_64 Syscall & Page Engine: ")
    let p = linux_alloc_pages(8192)
    let ok = linux_free_pages(p)
    let reactor = linux_epoll_new(1024)
    let r1 = linux_epoll_add_event(reactor, 5, 1)
    let r2 = linux_epoll_remove_event(r1, 5)
    if ok and (r2.active_subscriptions == 0):
        print("PASSED")
    else:
        print("FAILED")

# 2. Test Perceus In-Place Reuse Memory Allocator
fn test_perceus_allocator():
    print_str("-> [Pure Nova] Testing Perceus In-Place Reuse Memory Slab: ")
    let arena = perceus_arena_init(1)
    let b1 = perceus_alloc_exclusive(arena, 128)
    let b2 = perceus_try_reuse_in_place(b1, 64)
    let a1 = perceus_record_reuse(arena, b2.address == b1.address)
    let b3 = perceus_inc_ref(b2)
    let b4 = perceus_try_reuse_in_place(b3, 128)
    let a2 = perceus_record_reuse(a1, b4.address == b3.address)
    if (b2.address == b1.address) and (b4.address != b3.address):
        print("PASSED")
    else:
        print("FAILED")

# 3. Test Windows NT Subsystem
fn test_windows_subsystem():
    print_str("-> [Pure Nova] Testing Windows NT Virtual Memory & Threading: ")
    let wp = win32_alloc_virtual(131072)
    let h = win32_make_handle(100)
    let t = win32_spawn_thread(1, 65536)
    if win32_free_virtual(wp) and h.is_valid and win32_join_thread(t):
        print("PASSED")
    else:
        print("FAILED")

# 4. Test x86_64 Machine Code Opcode Encoder
fn test_x86_encoder():
    print_str("-> [Pure Nova] Testing x86_64 Direct Machine Code Encoder: ")
    let s0 = byte_stream_new()
    let s1 = encode_mov_reg_imm64(s0, 0, 42)
    let s2 = encode_add_reg_reg(s1, 0, 3)
    let s3 = encode_syscall(s2)
    let s4 = encode_ret(s3)
    if (s4.byte_count == 16) and (s4.checksum > 0):
        print("PASSED")
    else:
        print("FAILED")

# 5. Test Direct ELF64 and PE Binary Builders
fn test_binary_builders():
    print_str("-> [Pure Nova] Testing Direct ELF64 & Windows PE32+ Builders: ")
    let elf = elf64_default_header(4198400, 2)
    let code_seg = elf64_make_code_segment(4096, 4198400, 512)
    let elf_size = elf64_calc_total_size(512, 128)

    let pe_cfg = pe_default_config(4096, false)
    let pe_text = pe_make_text_section(4096, 512, 512)
    if (elf.machine_arch == 62) and (elf_size > 4096) and (pe_cfg.machine_type == 34404):
        print("PASSED")
    else:
        print("FAILED")

# 6. Test Multi-Threaded Work-Stealing Async Runtime
fn test_async_runtime():
    print_str("-> [Pure Nova] Testing Async/Await Work-Stealing Executor: ")
    let t1 = async_task_new(101, 10, 100)
    let t2 = async_task_mark_ready(t1)
    let t3 = async_task_step(t2, 100)

    let w1 = worker_new(1, 256)
    let w2 = worker_dispatch_task(w1)
    let w3 = worker_steal_from_peer(w2, 2)

    let pool = executor_pool_new(8)
    let p1 = executor_spawn(pool)
    let p2 = executor_task_done(p1)
    if (t3.state == task_state_completed()) and (w3.stolen_tasks == 1) and executor_is_idle(p2):
        print("PASSED")
    else:
        print("FAILED")

# 7. Test Colossus Enterprise Web Framework
fn test_colossus_web():
    print_str("-> [Pure Nova] Testing Colossus Enterprise Web Framework: ")
    let req = web_request_new(http_method_get(), "/api/v1/system/health", 0)
    let res = web_response_ok(128)
    let router = web_router_new()
    let r1 = web_router_add_route(router)
    let r2 = web_router_use_middleware(r1)
    let metrics = web_metrics_new()
    let m1 = web_metrics_record(metrics, 128)
    if (res.status_code == 200) and (r2.registered_routes == 1) and (m1.bytes_transferred == 128):
        print("PASSED")
    else:
        print("FAILED")

# 8. Test Titan LSM-Tree & Raft Consensus Database
fn test_titan_db():
    print_str("-> [Pure Nova] Testing Titan LSM-Tree & Raft Database Engine: ")
    let engine = titan_engine_init()
    let e1 = titan_write_entry(engine, 16, 64)
    let sst = titan_sstable_new(1, 0, 1000, 100, 5000)
    let has_key = titan_sstable_contains_hash(sst, 2500)

    let node = raft_node_new(1)
    let n1 = raft_start_election(node)
    let n2 = raft_become_leader(n1)
    let n3 = raft_commit_log(n2, 42)
    if (e1.wal_sequence == 1) and has_key and (n3.role == raft_role_leader()) and (n3.commit_index == 42):
        print("PASSED")
    else:
        print("FAILED")

# 9. Test Aether 2D/3D Software Graphics
fn test_aether_graphics():
    print_str("-> [Pure Nova] Testing Aether 2D/3D Software Graphics Engine: ")
    let c = color_coral_nova()
    let packed = color_pack_u32(c)
    let fb = framebuffer_new(640, 480)
    let fb1 = framebuffer_draw_pixel(fb, 100, 100)
    let b1 = bbox_new(10, 10, 50, 50)
    let b2 = bbox_new(40, 40, 80, 80)
    let collides = bbox_intersects(b1, b2)
    let gpu = gpu_pipeline_default(1)
    if (packed > 0) and (fb1.active_draw_calls == 1) and collides and gpu.depth_test_enabled:
        print("PASSED")
    else:
        print("FAILED")

