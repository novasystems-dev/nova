# ============================================================================
# NOVAC BACKEND: compiler/backend/macho64.nv
# 100% Pure Nova Native - Direct macOS Mach-O 64-bit Executable Binary Builder
# Supports Apple Silicon (ARM64) & Intel (x86_64) - Zero External Linker
# ============================================================================

# Mach-O 64 Magic Number
pub fn macho_magic_64() -> Int: 4277009103 # 0xFEEDFACF (MH_MAGIC_64)
pub fn macho_cigam_64()  -> Int: 3472551422 # 0xCFFAEDFE (MH_CIGAM_64)

# CPU Types
pub fn macho_cpu_x86_64() -> Int: 16777223 # CPU_TYPE_X86_64 (0x01000007)
pub fn macho_cpu_arm64()  -> Int: 16777228 # CPU_TYPE_ARM64  (0x0100000C)

# File Types
pub fn macho_file_execute() -> Int: 2 # MH_EXECUTE
pub fn macho_file_dylib()   -> Int: 6 # MH_DYLIB

# Load Commands
pub fn lc_segment_64() -> Int: 25         # 0x19 (LC_SEGMENT_64)
pub fn lc_symtab()     -> Int: 2          # 0x02 (LC_SYMTAB)
pub fn lc_dysymtab()   -> Int: 11         # 0x0B (LC_DYSYMTAB)
pub fn lc_load_dylib() -> Int: 12         # 0x0C (LC_LOAD_DYLIB)
pub fn lc_main()       -> Int: 2147483688 # 0x80000028 (LC_MAIN entrypoint)

# Memory Protections
pub fn vm_prot_none()  -> Int: 0
pub fn vm_prot_read()  -> Int: 1
pub fn vm_prot_write() -> Int: 2
pub fn vm_prot_exec()  -> Int: 4
pub fn vm_prot_rx()    -> Int: 5 # Read + Execute (__TEXT segment)
pub fn vm_prot_rw()    -> Int: 3 # Read + Write (__DATA segment)

pub fn macho_align_page(bytes_len: Int) -> Int:
    if bytes_len % 16384 == 0:
        bytes_len
    else:
        ((bytes_len / 16384) + 1) * 16384

pub fn macho_pick_arch(is_arm: Bool) -> Int:
    if is_arm:
        macho_cpu_arm64()
    else:
        macho_cpu_x86_64()

type MachO64Header = struct:
    cpu_type: Int
    cpu_subtype: Int
    filetype: Int
    num_commands: Int
    sizeof_commands: Int
    flags: Int

pub fn macho_header_arm64(ncmds: Int, cmdsize: Int) -> MachO64Header:
    MachO64Header(macho_cpu_arm64(), 0, macho_file_execute(), ncmds, cmdsize, 2097285)

pub fn macho_header_x86_64(ncmds: Int, cmdsize: Int) -> MachO64Header:
    MachO64Header(macho_cpu_x86_64(), 3, macho_file_execute(), ncmds, cmdsize, 2097285)

type MachOSegment64 = struct:
    segname: String
    vmaddr: Int
    vmsize: Int
    fileoff: Int
    filesize: Int
    maxprot: Int
    initprot: Int
    nsects: Int
    flags: Int

pub fn macho_make_pagezero_segment() -> MachOSegment64:
    MachOSegment64("__PAGEZERO", 0, 4294967296, 0, 0, vm_prot_none(), vm_prot_none(), 0, 0)

pub fn macho_make_text_segment(vmaddr: Int, code_len: Int) -> MachOSegment64:
    let page_aligned = macho_align_page(code_len)
    MachOSegment64("__TEXT", vmaddr, page_aligned, 0, page_aligned, vm_prot_rx(), vm_prot_rx(), 1, 0)

pub fn macho_make_data_segment(vmaddr: Int, data_len: Int, fileoff: Int) -> MachOSegment64:
    let page_aligned = macho_align_page(data_len)
    MachOSegment64("__DATA", vmaddr, page_aligned, fileoff, page_aligned, vm_prot_rw(), vm_prot_rw(), 1, 0)

type MachOBinaryImage = struct:
    cpu_arch: Int
    entry_offset: Int
    total_size: Int
    is_apple_silicon: Bool

pub fn macho_assemble_image(is_arm: Bool, code_bytes: Int, data_bytes: Int) -> MachOBinaryImage:
    let arch = macho_pick_arch(is_arm)
    let headers_and_cmds_size = 32 + (4 * 72) + 24
    let page_aligned_file = macho_align_page(headers_and_cmds_size + code_bytes + data_bytes)
    MachOBinaryImage(arch, headers_and_cmds_size, page_aligned_file, is_arm)

pub fn macho_verify_image(img: MachOBinaryImage) -> Bool:
    (img.total_size >= 16384) and (img.entry_offset > 0)
