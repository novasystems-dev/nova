pub fn run_arm64_matrix_sanity_check() -> Bool:
    let i1 = arm64_enc_1_add_x_x0_x0()
    let dp = arm64_encode_dp_reg(1, 0, 1, 2, 3)
    if i1.opcode_id == 1 and i1.reg_class == 1:
        true
    else:
        false

