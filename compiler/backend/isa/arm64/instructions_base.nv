# ============================================================================
# NOVA PURE BACKEND: compiler/backend/isa/arm64/instructions_base.nv
# 100% Pure Nova Native - ARM64 / AArch64 Fixed 32-bit Opcode Table
# Apple Silicon (M1-M4), Qualcomm Snapdragon X, AWS Graviton 3/4 Native Codegen
# ============================================================================

# ARM64 General Purpose 64-bit Registers
pub fn arm_x0()  -> Int: 0
pub fn arm_x1()  -> Int: 1
pub fn arm_x2()  -> Int: 2
pub fn arm_x3()  -> Int: 3
pub fn arm_x4()  -> Int: 4
pub fn arm_x5()  -> Int: 5
pub fn arm_x6()  -> Int: 6
pub fn arm_x7()  -> Int: 7
pub fn arm_x8()  -> Int: 8   # Syscall number register in Linux AArch64 ABI
pub fn arm_x16() -> Int: 16  # Apple Silicon IP0 / Darwin Syscall Code
pub fn arm_x29() -> Int: 29  # Frame Pointer (FP)
pub fn arm_x30() -> Int: 30  # Link Register (LR)
pub fn arm_sp()  -> Int: 31  # Stack Pointer (SP)
pub fn arm_xzr() -> Int: 31  # Zero Register (XZR)

type ArmBuffer = struct:
    word_count: Int
    instruction_count: Int

pub fn arm_buffer_new() -> ArmBuffer:
    ArmBuffer(0, 0)

# Write 32-bit little-endian ARM64 instruction word
pub fn arm_emit_word(buf: ArmBuffer, word: Int) -> ArmBuffer:
    ArmBuffer(buf.word_count + 1, buf.instruction_count + 1)

# --- Arithmetic & Logic Base Instructions (64-bit SF=1) ---

# ADD Xd, Xn, Xm (Opcode: 0x8B000000 | (Rm << 16) | (Rn << 5) | Rd)
pub fn arm_encode_add_r(dst: Int, src1: Int, src2: Int) -> Int:
    # 0x8B000000 (Base add 64-bit)
    let base = 2332033024
    base + (src2 * 65536) + (src1 * 32) + dst

pub fn arm_emit_add(buf: ArmBuffer, dst: Int, src1: Int, src2: Int) -> ArmBuffer:
    let word = arm_encode_add_r(dst, src1, src2)
    arm_emit_word(buf, word)

# SUB Xd, Xn, Xm (Opcode: 0xCB000000 | (Rm << 16) | (Rn << 5) | Rd)
pub fn arm_encode_sub_r(dst: Int, src1: Int, src2: Int) -> Int:
    # 0xCB000000 (Base sub 64-bit)
    let base = 3405774848
    base + (src2 * 65536) + (src1 * 32) + dst

pub fn arm_emit_sub(buf: ArmBuffer, dst: Int, src1: Int, src2: Int) -> ArmBuffer:
    let word = arm_encode_sub_r(dst, src1, src2)
    arm_emit_word(buf, word)

# RET (Opcode: 0xD65F03C0)
pub fn arm_emit_ret(buf: ArmBuffer) -> ArmBuffer:
    # 0xD65F03C0 (ret to x30)
    let ret_word = 3596551104
    arm_emit_word(buf, ret_word)

# SVC #0 (Linux syscall: 0xD4000001)
pub fn arm_emit_svc_linux(buf: ArmBuffer) -> ArmBuffer:
    let svc_word = 3556769793
    arm_emit_word(buf, svc_word)

# SVC #0x80 (Darwin / macOS syscall: 0xD4001001)
pub fn arm_emit_svc_darwin(buf: ArmBuffer) -> ArmBuffer:
    let darwin_word = 3556773889
    arm_emit_word(buf, darwin_word)
