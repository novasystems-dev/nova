# ============================================================================
# NOVA COMPILER BACKEND: FULL AMD64 & INTEL 64 (x86_64) OPCODE MATRIX
# Module: compiler/backend/isa/x86_64/full_opcode_matrix.nv
# Reference: Intel 64 and IA-32 Architectures Software Developer's Manual Vol 2
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type X86OpcodeEntry = struct:
    opcode_id: Int
    mnemonic: String
    byte1: Int
    byte2: Int
    prefix_rex: Int
    has_modrm: Bool
    modrm_default: Int
    is_simd: Bool
    is_avx512: Bool
    operand_size_bits: Int

pub fn x86_encode_modrm(mode: Int, reg: Int, rm: Int) -> Int:
    let b1 = (mode % 4) * 64
    let b2 = (reg % 8) * 8
    let b3 = rm % 8
    b1 + b2 + b3

fn pick_scale_bits(scale: Int) -> Int:
    if scale == 8:
        192
    elif scale == 4:
        128
    elif scale == 2:
        64
    else:
        0

pub fn x86_encode_sib(scale: Int, index: Int, base_reg: Int) -> Int:
    let s_bits = pick_scale_bits(scale)
    let i_bits = (index % 8) * 8
    let b_bits = base_reg % 8
    s_bits + i_bits + b_bits

fn check_bit(cond: Bool) -> Int:
    if cond == true:
        1
    else:
        0

pub fn x86_encode_rex(w: Bool, r: Bool, x: Bool, b: Bool) -> Int:
    let w_bit = check_bit(w) * 8
    let r_bit = check_bit(r) * 4
    let x_bit = check_bit(x) * 2
    let b_bit = check_bit(b)
    64 + w_bit + r_bit + x_bit + b_bit

fn pick_r_inv(r: Bool) -> Int:
    if r == true:
        0
    else:
        128

fn pick_l_bit(l: Bool) -> Int:
    if l == true:
        4
    else:
        0

pub fn x86_encode_vex2(r: Bool, vvvv: Int, l: Bool, pp: Int) -> Int:
    let r_inv = pick_r_inv(r)
    let v_inv = (15 - (vvvv % 16)) * 8
    let l_bit = pick_l_bit(l)
    let pp_bits = pp % 4
    r_inv + v_inv + l_bit + pp_bits

