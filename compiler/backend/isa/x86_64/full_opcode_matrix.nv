pub fn x86_total_instructions() -> Int: 26112

pub fn run_x86_matrix_sanity_check() -> Bool:
    let i1 = x86_enc_1_add_r64_r0_r0()
    let modrm = x86_encode_modrm(3, 0, 1)
    let rex = x86_encode_rex(true, false, false, true)
    if i1.opcode_id == 1 and modrm == 193 and rex == 73:
        true
    else:
        false

