pub fn wasm_lookup_category(is_simd: Bool, is_atomic: Bool) -> String:
    if is_simd == true:
        "WASM_SIMD128"
    else:
        if is_atomic == true:
            "WASM_THREADS_ATOMICS"
        else:
            "WASM_CORE_NUMERIC"

