pub fn run_riscv_matrix_sanity_check() -> Bool:
    let i1 = rv_enc_1_add_x0_x0()
    let enc = rv_encode_r_type(0, 2, 1, 0, 3, 51)
    if i1.opcode_id == 1 and i1.opcode_7bit == 51:
        true
    else:
        false

