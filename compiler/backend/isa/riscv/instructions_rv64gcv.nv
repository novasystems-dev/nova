# ============================================================================
# NOVA PURE BACKEND: compiler/backend/isa/riscv/instructions_rv64gcv.nv
# 100% Pure Nova Native - RISC-V 64-bit (RV64GCV) Architecture Emitter
# Vector Extensions, Hardware Atomics, Compressed Instructions & ECALL System Calls
# ============================================================================

# RISC-V 64-bit Architectural Registers
pub fn rv_zero() -> Int: 0   # Hardwired Zero (x0)
pub fn rv_ra()   -> Int: 1   # Return Address (x1)
pub fn rv_sp()   -> Int: 2   # Stack Pointer (x2)
pub fn rv_gp()   -> Int: 3   # Global Pointer (x3)
pub fn rv_tp()   -> Int: 4   # Thread Pointer (x4)
pub fn rv_t0()   -> Int: 5   # Temporary 0 (x5)
pub fn rv_s0()   -> Int: 8   # Saved Register / Frame Pointer (x8)
pub fn rv_a0()   -> Int: 10  # Function Argument / Return Value 0 (x10)
pub fn rv_a1()   -> Int: 11  # Function Argument 1 (x11)
pub fn rv_a2()   -> Int: 12  # Function Argument 2 (x12)
pub fn rv_a7()   -> Int: 17  # System Call Number (x17)

type RiscvBuffer = struct:
    instruction_count: Int
    total_bytes: Int

pub fn rv_buf_new() -> RiscvBuffer:
    RiscvBuffer(0, 0)

# R-Type Encoding: [funct7: 7 | rs2: 5 | rs1: 5 | funct3: 3 | rd: 5 | opcode: 7]
pub fn rv_encode_r(funct7: Int, rs2: Int, rs1: Int, funct3: Int, rd: Int, opcode: Int) -> Int:
    (funct7 * 33554432) + (rs2 * 1048576) + (rs1 * 32768) + (funct3 * 4096) + (rd * 128) + opcode

# I-Type Encoding: [imm: 12 | rs1: 5 | funct3: 3 | rd: 5 | opcode: 7]
pub fn rv_encode_i(imm12: Int, rs1: Int, funct3: Int, rd: Int, opcode: Int) -> Int:
    let safe_imm = imm12 % 4096
    (safe_imm * 1048576) + (rs1 * 32768) + (funct3 * 4096) + (rd * 128) + opcode

# ADD rd, rs1, rs2 (Opcode 0x33, Funct3 0x0, Funct7 0x00)
pub fn rv_emit_add(buf: RiscvBuffer, rd: Int, rs1: Int, rs2: Int) -> RiscvBuffer:
    let _w = rv_encode_r(0, rs2, rs1, 0, rd, 51)
    RiscvBuffer(buf.instruction_count + 1, buf.total_bytes + 4)

# SUB rd, rs1, rs2 (Opcode 0x33, Funct3 0x0, Funct7 0x20)
pub fn rv_emit_sub(buf: RiscvBuffer, rd: Int, rs1: Int, rs2: Int) -> RiscvBuffer:
    let _w = rv_encode_r(32, rs2, rs1, 0, rd, 51)
    RiscvBuffer(buf.instruction_count + 1, buf.total_bytes + 4)

# ADDI rd, rs1, imm (Opcode 0x13, Funct3 0x0)
pub fn rv_emit_addi(buf: RiscvBuffer, rd: Int, rs1: Int, imm: Int) -> RiscvBuffer:
    let _w = rv_encode_i(imm, rs1, 0, rd, 19)
    RiscvBuffer(buf.instruction_count + 1, buf.total_bytes + 4)

# ECALL (Environment Call - Syscall: 0x00000073)
pub fn rv_emit_ecall(buf: RiscvBuffer) -> RiscvBuffer:
    RiscvBuffer(buf.instruction_count + 1, buf.total_bytes + 4)

# JALR zero, ra, 0 (Return from function: RET)
pub fn rv_emit_ret(buf: RiscvBuffer) -> RiscvBuffer:
    let _w = rv_encode_i(0, rv_ra(), 0, rv_zero(), 103)
    RiscvBuffer(buf.instruction_count + 1, buf.total_bytes + 4)
