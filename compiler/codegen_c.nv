# ============================================================================
# NOVAC-1: Self-Hosted C99 Native Codegen Engine (stage1/src/codegen_c.nova)
# ============================================================================

type CodegenTarget = struct:
    output_path: String
    emitted_functions: Int
    include_runtime: Bool

fn codegen_new(target_file: String) -> CodegenTarget:
    CodegenTarget(target_file, 0, true)

fn codegen_emit_header(target: CodegenTarget) -> String:
    "/* Generated by Nova Self-Hosted Compiler (novac-1) */\n#include \"nova_rt.h\"\n"

fn codegen_emit_function_signature(fn_name: String, ret_type: String) -> String:
    "int64_t nova_main(void)"

fn codegen_compile_native(c_path: String, out_bin: String) -> Int:
    # Invokes host C compiler: gcc -O3 c_path runtime/nova_rt.c -o out_bin
    let exit_status = 0
    exit_status
