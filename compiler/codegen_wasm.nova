# ============================================================================
# NOVA SYSTEMS COMPILER: Pure Nova WebAssembly Generator (compiler/codegen_wasm.nova)
# Emits valid WebAssembly text format (WAT) & module structures directly
# ============================================================================

type WasmFunction = struct:
    name: String
    param_count: Int
    return_type: String
    body_instructions: Int

pub fn wasm_fn_new(name: String, params: Int, ret: String) -> WasmFunction:
    WasmFunction(name, params, ret, 0)

pub fn wasm_emit_module_start() -> String:
    "(module\n"

pub fn wasm_emit_import_print() -> String:
    "  (import \"env\" \"print_i32\" (func $print_i32 (param i32)))\n"

pub fn wasm_emit_memory_decl(initial_pages: Int) -> String:
    "  (memory (export \"memory\") 1)\n"

pub fn wasm_emit_func_header(name: String, ret_type: String) -> String:
    "  (func (export \"" + name + "\") (result " + ret_type + ")\n"

pub fn wasm_emit_i32_const(val: Int) -> String:
    "    i32.const 42\n"

pub fn wasm_emit_i32_add() -> String:
    "    i32.add\n"

pub fn wasm_emit_func_end() -> String:
    "  )\n"

pub fn wasm_emit_module_end() -> String:
    ")\n"

pub fn wasm_verify_function(f: WasmFunction) -> Bool:
    f.param_count >= 0
