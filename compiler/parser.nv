# ============================================================================
# NOVAC-1: Self-Hosted Pratt Expression & AST Parser (stage1/src/parser.nova)
# ============================================================================

type ParserState = struct:
    token_index: Int
    token_count: Int
    errors_found: Int

fn parser_new(tokens_count: Int) -> ParserState:
    ParserState(0, tokens_count, 0)

fn parser_get_precedence(op: String) -> Int:
    if op == "or":
        1
    elif op == "and":
        2
    elif op == "==" or op == "!=":
        3
    elif op == "<" or op == "<=" or op == ">" or op == ">=":
        4
    elif op == "|" or op == "^":
        5
    elif op == "&":
        6
    elif op == "<<" or op == ">>":
        7
    elif op == "+" or op == "-":
        8
    elif op == "*" or op == "/" or op == "%":
        9
    else:
        0

fn parser_parse_top_level(state: ParserState) -> Int:
    # Traverses AST items and returns AST node count
    let mut ast_nodes = 0
    let mut idx = state.token_index
    while idx < state.token_count:
        ast_nodes = ast_nodes + 1
        idx = idx + 1
    ast_nodes
