type MachOLoadCommand = struct:
    id: Int
    cmd: Int
    cmdsize: Int
    segname: String
    vmaddr: Int
    vmsize: Int
    fileoff: Int
    filesize: Int

pub fn macho_resolve_cmd_name(cmd: Int) -> String:
    if cmd == 25:
        "LC_SEGMENT_64"
    else:
        if cmd == 2:
            "LC_SYMTAB"
        else:
            if cmd == 11:
                "LC_DYSYMTAB"
            else:
                if cmd == 14:
                    "LC_LOAD_DYLINKER"
                else:
                    if cmd == 50:
                        "LC_MAIN"
                    else:
                        "LC_LOAD_DYLIB"

