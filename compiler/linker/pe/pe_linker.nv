type PeSectionHeader = struct:
    id: Int
    name: String
    virtual_size: Int
    virtual_address: Int
    raw_data_size: Int
    raw_data_ptr: Int
    characteristics: Int

type PeImportEntry = struct:
    id: Int
    dll_name: String
    function_name: String
    hint: Int
    thunk_rva: Int

pub fn pe_resolve_chars(is_code: Bool, is_writable: Bool) -> Int:
    if is_code == true:
        1610612768
    else:
        if is_writable == true:
            3221225536
        else:
            1073741888

