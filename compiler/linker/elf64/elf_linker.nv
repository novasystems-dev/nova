# ============================================================================
# NOVA COMPILER LINKER: ELF64 STANDALONE OBJECT & EXECUTABLE LINKER
# Module: compiler/linker/elf64/elf_linker.nv
# Linux ELF64 Header, Sections, GOT/PLT, Relocations (Zero GNU ld)
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type Elf64Section = struct:
    id: Int
    name: String
    sh_type: Int
    sh_flags: Int
    sh_addr: Int
    sh_offset: Int
    sh_size: Int
    sh_addralign: Int

type Elf64Relocation = struct:
    r_offset: Int
    r_type: Int
    r_sym: Int
    r_addend: Int

pub fn elf64_encode_reloc(offset: Int, r_type: Int, sym: Int, addend: Int) -> Elf64Relocation:
    Elf64Relocation(offset, r_type, sym, addend)

pub fn elf64_resolve_sh_type(name: String) -> Int:
    if name == ".text":
        1
    else:
        if name == ".rodata":
            1
        else:
            if name == ".data":
                1
            else:
                if name == ".bss":
                    8
                else:
                    if name == ".symtab":
                        2
                    else:
                        if name == ".strtab":
                            3
                        else:
                            1

pub fn elf64_reloc_entry_1() -> Elf64Relocation:
