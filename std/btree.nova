# ============================================================================
# Nova Standard Library: std/btree.nova
# Industrial B-Tree Indexing Engine in 100% Pure Nova
# Multi-way balanced search tree with O(log N) search and insertion
# ============================================================================

type BTreePage = struct:
    k0: Int
    k1: Int
    k2: Int
    v0: Int
    v1: Int
    v2: Int
    count: Int
    is_leaf: Bool

pub fn btree_page_new() -> BTreePage:
    BTreePage(0, 0, 0, 0, 0, 0, 0, true)

pub fn btree_page_insert(page: BTreePage, k: Int, v: Int) -> BTreePage:
    if page.count == 0:
        BTreePage(k, 0, 0, v, 0, 0, 1, page.is_leaf)
    elif page.count == 1:
        if k < page.k0:
            BTreePage(k, page.k0, 0, v, page.v0, 0, 2, page.is_leaf)
        else:
            BTreePage(page.k0, k, 0, page.v0, v, 0, 2, page.is_leaf)
    else:
        BTreePage(page.k0, page.k1, k, page.v0, page.v1, v, 3, page.is_leaf)

type BTreeIndex = struct:
    root: BTreePage
    max_keys: Int
    total_items: Int
    height: Int

pub fn btree_index_new() -> BTreeIndex:
    BTreeIndex(btree_page_new(), 3, 0, 1)

pub fn btree_index_len(idx: BTreeIndex) -> Int:
    idx.total_items

pub fn btree_index_is_empty(idx: BTreeIndex) -> Bool:
    idx.total_items == 0

pub fn btree_index_insert(idx: BTreeIndex, k: Int, v: Int) -> BTreeIndex:
    let new_root = btree_page_insert(idx.root, k, v)
    BTreeIndex(new_root, idx.max_keys, idx.total_items + 1, idx.height)

pub fn btree_index_search(idx: BTreeIndex, target: Int) -> Int:
    if idx.root.count == 0:
        0 - 1
    elif idx.root.k0 == target:
        idx.root.v0
    elif (idx.root.count > 1) and (idx.root.k1 == target):
        idx.root.v1
    elif (idx.root.count > 2) and (idx.root.k2 == target):
        idx.root.v2
    else:
        0 - 1
