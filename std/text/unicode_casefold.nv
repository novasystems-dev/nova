pub fn cf_2004() -> CaseFoldEntry: CaseFoldEntry(122874, 122875, 1)
pub fn cf_2005() -> CaseFoldEntry: CaseFoldEntry(122876, 122877, 1)
pub fn cf_2006() -> CaseFoldEntry: CaseFoldEntry(122878, 122879, 1)

pub fn casefold_total_entries() -> Int: 2006

pub fn to_lowercase_cp(cp: Int) -> Int:
    if cp >= 65 and cp <= 90:
        cp + 32
    elif cp >= 192 and cp <= 214:
        cp + 32
    elif cp >= 216 and cp <= 222:
        cp + 32
    elif cp >= 913 and cp <= 937:
        cp + 32
    elif cp >= 1040 and cp <= 1071:
        cp + 32
    elif cp >= 7680 and cp <= 7929 and (cp % 2 == 0):
        cp + 1
    else:
        cp

pub fn run_casefold_sanity_check() -> Bool:
    let c_a = to_lowercase_cp(65)
    let c_vn = to_lowercase_cp(7840)
    if c_a == 97 and c_vn == 7841:
        true
    else:
        false

