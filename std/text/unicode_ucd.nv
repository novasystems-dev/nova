pub fn block_count() -> Int: 500

pub fn is_ascii(cp: Int) -> Bool:
    if cp >= 0 and cp <= 127:
        true
    else:
        false

pub fn is_whitespace(cp: Int) -> Bool:
    if cp == 32 or cp == 9 or cp == 10 or cp == 13:
        true
    else:
        false

pub fn run_ucd_sanity_check() -> Bool:
    let b1 = ucd_block_1()
    let b_last = ucd_block_500()
    let ascii_ok = is_ascii(65)
    if b1.block_id == 1 and b_last.block_id == 500 and ascii_ok == true:
        true
    else:
        false

