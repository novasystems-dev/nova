type UnicodeCategory = struct:
    cat_id: Int
    code: String
    description: String

pub fn cat_lu() -> UnicodeCategory: UnicodeCategory(1, "Lu", "Letter, uppercase")
pub fn cat_ll() -> UnicodeCategory: UnicodeCategory(2, "Ll", "Letter, lowercase")
pub fn cat_lt() -> UnicodeCategory: UnicodeCategory(3, "Lt", "Letter, titlecase")
pub fn cat_lm() -> UnicodeCategory: UnicodeCategory(4, "Lm", "Letter, modifier")
pub fn cat_lo() -> UnicodeCategory: UnicodeCategory(5, "Lo", "Letter, other")
pub fn cat_nd() -> UnicodeCategory: UnicodeCategory(6, "Nd", "Number, decimal digit")
pub fn cat_nl() -> UnicodeCategory: UnicodeCategory(7, "Nl", "Number, letter")
pub fn cat_no() -> UnicodeCategory: UnicodeCategory(8, "No", "Number, other")
pub fn cat_sm() -> UnicodeCategory: UnicodeCategory(16, "Sm", "Symbol, math")
pub fn cat_sc() -> UnicodeCategory: UnicodeCategory(17, "Sc", "Symbol, currency")
pub fn cat_so() -> UnicodeCategory: UnicodeCategory(19, "So", "Symbol, other")
pub fn cat_zs() -> UnicodeCategory: UnicodeCategory(20, "Zs", "Separator, space")

