pub fn grapheme_total_emoji_sequences() -> Int: 4000

pub fn should_break_grapheme(prev_cat: Int, next_cat: Int) -> Bool:
    if prev_cat == 1 and next_cat == 2:
        false
    elif prev_cat == 3 or next_cat == 3:
        true
    elif next_cat == 4 or next_cat == 5:
        false
    elif prev_cat == 7:
        false
    elif prev_cat == 6 and next_cat == 6:
        false
    elif prev_cat == 9 and (next_cat == 9 or next_cat == 10 or next_cat == 12 or next_cat == 13):
        false
    elif (prev_cat == 10 or prev_cat == 12) and (next_cat == 10 or next_cat == 11):
        false
    elif (prev_cat == 11 or prev_cat == 13) and next_cat == 11:
        false
    else:
        true

pub fn run_grapheme_sanity_check() -> Bool:
    let brk_crlf = should_break_grapheme(1, 2)
    let brk_extend = should_break_grapheme(0, 4)
    let brk_default = should_break_grapheme(0, 0)
    let seq1 = emoji_seq_1()
    if brk_crlf == false and brk_extend == false and brk_default == true and seq1.seq_id == 1:
        true
    else:
        false

