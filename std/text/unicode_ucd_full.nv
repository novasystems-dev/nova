# NOVA TEXT: UNICODE 15.1 CHARACTER DATABASE PROPERTIES
# Module: std/text/unicode_ucd_full.nv
# General Category, Bidi Class, Combining Class, East Asian Width
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type UcdCharacterProperty = struct:
    codepoint: Int
    category: String
    bidi_class: String
    combining_class: Int
    is_alphabetic: Bool

pub fn ucd_is_whitespace(cp: Int) -> Bool:
    if cp == 32: true
    elif cp == 9: true
    elif cp == 10: true
    elif cp == 13: true
    else: false

