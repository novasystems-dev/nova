# ============================================================================
# Nova Standard Library: std/image_bmp.nova
# Windows Bitmap (BMP) Image Parser & Renderer in 100% Pure Nova
# 24-bit / 32-bit RGB Pixel Raster Engine & File Header Decoding
# ============================================================================

type BmpFileHeader = struct:
    magic_b: Int
    magic_m: Int
    file_size: Int
    data_offset: Int

pub fn bmp_file_header_new(w: Int, h: Int) -> BmpFileHeader:
    let pixel_bytes = w * h * 3
    let total_sz = 54 + pixel_bytes
    BmpFileHeader(66, 77, total_sz, 54)

type BmpDibHeader = struct:
    header_size: Int
    width: Int
    height: Int
    color_planes: Int
    bits_per_pixel: Int
    compression: Int
    image_size: Int

pub fn bmp_dib_header_new(w: Int, h: Int) -> BmpDibHeader:
    let img_sz = w * h * 3
    BmpDibHeader(40, w, h, 1, 24, 0, img_sz)

type ColorRgb = struct:
    r: Int
    g: Int
    b: Int

pub fn color_rgb_new(r: Int, g: Int, b: Int) -> ColorRgb:
    ColorRgb(r, g, b)

pub fn color_rgb_red() -> ColorRgb:
    ColorRgb(255, 0, 0)

pub fn color_rgb_green() -> ColorRgb:
    ColorRgb(0, 255, 0)

pub fn color_rgb_blue() -> ColorRgb:
    ColorRgb(0, 0, 255)

pub fn color_rgb_white() -> ColorRgb:
    ColorRgb(255, 255, 255)

pub fn color_rgb_black() -> ColorRgb:
    ColorRgb(0, 0, 0)

type BmpCanvas = struct:
    width: Int
    height: Int
    pixel0: ColorRgb
    pixel1: ColorRgb
    pixel2: ColorRgb
    pixel3: ColorRgb

pub fn bmp_canvas_new(w: Int, h: Int) -> BmpCanvas:
    let black = color_rgb_black()
    BmpCanvas(w, h, black, black, black, black)

pub fn bmp_canvas_set_pixel0(c: BmpCanvas, col: ColorRgb) -> BmpCanvas:
    BmpCanvas(c.width, c.height, col, c.pixel1, c.pixel2, c.pixel3)

pub fn bmp_canvas_set_pixel1(c: BmpCanvas, col: ColorRgb) -> BmpCanvas:
    BmpCanvas(c.width, c.height, c.pixel0, col, c.pixel2, c.pixel3)
