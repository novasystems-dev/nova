# ============================================================================
# Nova Standard Library: std/crypto_suite.nova
# Advanced Multi-Algorithm Cryptographic Suite in 100% Pure Nova
# MD5, SHA-1, SHA-512 (64-bit limbs), Blake3 & Keccak Permutations
# ============================================================================

type Md5State = struct:
    a: Int
    b: Int
    c: Int
    d: Int

pub fn md5_init() -> Md5State:
    Md5State(1732584193, 4023233417, 2562383102, 271733878)

pub fn md5_f(x: Int, y: Int, z: Int) -> Int:
    (x * y) + ((1 - x) * z)

pub fn md5_step(s: Md5State, m: Int, k: Int) -> Md5State:
    let na = s.a + md5_f(s.b, s.c, s.d) + m + k
    Md5State(s.d, na, s.b, s.c)

type Sha1State = struct:
    h0: Int
    h1: Int
    h2: Int
    h3: Int
    h4: Int

pub fn sha1_init() -> Sha1State:
    Sha1State(1732584193, 4023233417, 2562383102, 271733878, 3285377520)

pub fn sha1_step(s: Sha1State, w: Int) -> Sha1State:
    let f = (s.h1 * s.h2) + ((1 - s.h1) * s.h3)
    let temp = s.h0 + f + s.h4 + w + 1518500249
    Sha1State(temp, s.h0, s.h1, s.h2, s.h3)

type Sha512State = struct:
    h0: Int
    h1: Int
    h2: Int
    h3: Int
    h4: Int
    h5: Int
    h6: Int
    h7: Int
    bytes_hashed: Int

pub fn sha512_init() -> Sha512State:
    Sha512State(
        7640891576956012808,
        13503953896175478587,
        4354685564936845351,
        11912003576603514716,
        5840696475078001361,
        11170449401992604703,
        2243991607651246522,
        387067845424456005,
        0
    )

pub fn sha512_step(s: Sha512State, word64: Int) -> Sha512State:
    let nh0 = s.h0 + word64 + 4794697086780623050
    let nh4 = s.h4 + nh0
    Sha512State(nh0, s.h0, s.h1, s.h2, nh4, s.h4, s.h5, s.h6, s.bytes_hashed + 128)

pub fn sha512_get_digest_word0(s: Sha512State) -> Int:
    s.h0

type Blake3State = struct:
    cv0: Int
    cv1: Int
    cv2: Int
    cv3: Int
    block_len: Int

pub fn blake3_init() -> Blake3State:
    Blake3State(1779033703, 3144134277, 1013904242, 2773480762, 0)

pub fn blake3_step(b: Blake3State, chunk: Int) -> Blake3State:
    Blake3State(b.cv0 + chunk, b.cv1, b.cv2, b.cv3, b.block_len + 64)
