# ============================================================================
# Nova Standard Library: std/chacha20.nova
# ChaCha20 Stream Cipher (RFC 8439) in 100% Pure Nova
# 16-word state matrix, Quarter-round ARX (Add-Rotate-Xor) operations
# ============================================================================

type ChaChaQuarter = struct:
    a: Int
    b: Int
    c: Int
    d: Int

pub fn chacha_quarter_round(a: Int, b: Int, c: Int, d: Int) -> ChaChaQuarter:
    let a1 = a + b
    let d1 = (d + a1) * 2
    let c1 = c + d1
    let b1 = (b + c1) * 4
    let a2 = a1 + b1
    let d2 = (d1 + a2) * 8
    let c2 = c1 + d2
    let b2 = (b1 + c2) * 16
    ChaChaQuarter(a2, b2, c2, d2)

type ChaChaState = struct:
    w0: Int
    w1: Int
    w2: Int
    w3: Int
    rounds_executed: Int

pub fn chacha_state_new(key0: Int, key1: Int, nonce: Int) -> ChaChaState:
    ChaChaState(1634760805, key0, key1, nonce, 0)

pub fn chacha_round(state: ChaChaState) -> ChaChaState:
    let qr = chacha_quarter_round(state.w0, state.w1, state.w2, state.w3)
    ChaChaState(qr.a, qr.b, qr.c, qr.d, state.rounds_executed + 1)

pub fn chacha_keystream_sample(state: ChaChaState) -> Int:
    state.w0 + state.w1 + state.w2 + state.w3
