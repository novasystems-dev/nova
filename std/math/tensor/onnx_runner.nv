# ============================================================================
# NOVA TENSOR: OPEN NEURAL NETWORK EXCHANGE (ONNX) OPERATOR GRAPH
# Module: std/math/tensor/onnx_runner.nv
# ONNX Operator Specification & Computational Graph Dispatcher
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type OnnxOperatorEntry = struct:
    id: Int
    op_name: String
    version_since: Int
    input_count: Int
    output_count: Int
    has_attributes: Bool

pub fn onnx_is_quantized(name: String) -> Bool:
    if name == "QLinearMatMul": true
    elif name == "QLinearConv": true
    else: false

pub fn onnx_op_entry_1() -> OnnxOperatorEntry:
    OnnxOperatorEntry(1, "Relu_1", 19, 2, 1, true)

