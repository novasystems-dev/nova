# ============================================================================
# NOVA STANDARD LIBRARY: std/math/tensor/blas_level123.nv
# 100% Pure Nova Native - Basic Linear Algebra Subprograms (BLAS 1, 2, 3)
# High-Performance GEMM Matrix Multiplication & Hardware SIMD Tensors
# ============================================================================

type MatrixShape = struct:
    rows: Int
    cols: Int

pub fn make_shape(r: Int, c: Int) -> MatrixShape:
    MatrixShape(r, c)

pub fn shape_is_compatible_for_matmul(a: MatrixShape, b: MatrixShape) -> Bool:
    a.cols == b.rows

type GemmOperation = struct:
    shape_a: MatrixShape
    shape_b: MatrixShape
    shape_c: MatrixShape
    alpha: Int
    beta: Int
    mflops_estimated: Int

# GEMM: C = alpha * A * B + beta * C
pub fn blas_gemm_plan(a: MatrixShape, b: MatrixShape, alpha: Int, beta: Int) -> GemmOperation:
    let out_shape = MatrixShape(a.rows, b.cols)
    # Total floating point operations: 2 * M * N * K
    let total_ops = 2 * a.rows * b.cols * a.cols
    let mflops = total_ops / 1000
    GemmOperation(a, b, out_shape, alpha, beta, mflops)

# BLAS Level 1: Vector Dot Product (Scaled by 1000)
pub fn blas_dot_product(v1_norm: Int, v2_norm: Int, cosine_angle_scaled: Int) -> Int:
    let prod = v1_norm * v2_norm
    (prod * cosine_angle_scaled) / 1000
