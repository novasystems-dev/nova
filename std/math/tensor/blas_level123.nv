type BlasKernelDescriptor = struct:
    id: Int
    name: String
    level: Int
    m_tile: Int
    n_tile: Int
    k_tile: Int
    is_vectorized: Bool

pub fn blas_compute_gemm_flops(m: Int, n: Int, k: Int) -> Int:
    2 * m * n * k

