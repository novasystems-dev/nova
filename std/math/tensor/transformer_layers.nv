type TransformerWeightParam = struct:
    layer_id: Int
    name: String
    dim_in: Int
    dim_out: Int
    quant_bits: Int

pub fn transformer_rope_freq(pos: Int, dim_idx: Int) -> Int:
    let base = 10000
    (pos * 1000 + dim_idx) % base

