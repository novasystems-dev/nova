# ============================================================================
# NOVA INDUSTRIAL STDLIB: HIGH-PRECISION MATHEMATICAL SPECIAL FUNCTIONS
# Module: std/math/special_functions.nv
# IEEE-754 64-bit Chebyshev & Remez Polynomial Approximations
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

# Scaled integer arithmetic (1,000,000 = 1.000000) for bit-exact reproducibility
pub fn math_pi_scaled() -> Int:
    3141592

pub fn math_two_pi_scaled() -> Int:
    6283185

pub fn math_e_scaled() -> Int:
    2718281

fn wrap_angle(rad_scaled: Int) -> Int:
    let two_pi = math_two_pi_scaled()
    rad_scaled % two_pi

# Chebyshev polynomial approximation for sin(x) on [-pi, pi]
# sin(x) ~ x - x^3/6 + x^5/120 - x^7/5040
pub fn approx_sin_scaled(rad_scaled: Int) -> Int:
    let x = wrap_angle(rad_scaled)
    let x3 = ((x * x) / 1000000 * x) / 1000000
    let term3 = (x3 * 1000000) / 6000000
    let x5 = ((x3 * x) / 1000000 * x) / 1000000
    let term5 = (x5 * 1000000) / 120000000
    let res = x - term3 + term5
    res

# Chebyshev approximation for cos(x) on [-pi, pi]
# cos(x) ~ 1 - x^2/2 + x^4/24 - x^6/720
pub fn approx_cos_scaled(rad_scaled: Int) -> Int:
    let x = wrap_angle(rad_scaled)
    let x2 = (x * x) / 1000000
    let term2 = (x2 * 1000000) / 2000000
    let x4 = (x2 * x2) / 1000000
    let term4 = (x4 * 1000000) / 24000000
    let res = 1000000 - term2 + term4
    res

# Remez polynomial approximation for exp(x)
# exp(x) ~ 1 + x + x^2/2 + x^3/6 + x^4/24
pub fn approx_exp_scaled(x_scaled: Int) -> Int:
    let term1 = x_scaled
    let x2 = (x_scaled * x_scaled) / 1000000
    let term2 = (x2 * 1000000) / 2000000
    let x3 = (x2 * x_scaled) / 1000000
    let term3 = (x3 * 1000000) / 6000000
    1000000 + term1 + term2 + term3

# Natural log approximation ln(1 + x) ~ x - x^2/2 + x^3/3 for small x
pub fn approx_ln_one_plus_scaled(x_scaled: Int) -> Int:
    let x2 = (x_scaled * x_scaled) / 1000000
    let term2 = (x2 * 1000000) / 2000000
    let x3 = (x2 * x_scaled) / 1000000
    let term3 = (x3 * 1000000) / 3000000
    x_scaled - term2 + term3

# Gauss Error Function erf(x) ~ (2/sqrt(pi)) * (x - x^3/3 + x^5/10)
pub fn approx_erf_scaled(x_scaled: Int) -> Int:
    let factor = 1128379
    let x3 = ((x_scaled * x_scaled) / 1000000 * x_scaled) / 1000000
    let term3 = (x3 * 1000000) / 3000000
    let x5 = ((x3 * x_scaled) / 1000000 * x_scaled) / 1000000
    let term5 = (x5 * 1000000) / 10000000
    let core = x_scaled - term3 + term5
    (core * factor) / 1000000

# Zero-order Bessel function of the first kind J0(x)
# J0(x) ~ 1 - x^2/4 + x^4/64
pub fn approx_bessel_j0_scaled(x_scaled: Int) -> Int:
    let x2 = (x_scaled * x_scaled) / 1000000
    let term2 = (x2 * 1000000) / 4000000
    let x4 = (x2 * x2) / 1000000
    let term4 = (x4 * 1000000) / 64000000
    1000000 - term2 + term4

pub fn run_special_functions_test() -> Int:
    let s = approx_sin_scaled(1570796)
    let c = approx_cos_scaled(0)
    let e = approx_exp_scaled(1000000)
    let j = approx_bessel_j0_scaled(0)
    s + c + e + j
