# ============================================================================
# NOVA NUMERICAL COMPUTING: IEEE 754-2019 BINARY128 QUAD PRECISION
# Module: std/math/ieee754_quad.nv
# 128-bit Quadruple Precision Floating Point Software Arithmetic
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type QuadFloat = struct:
    sign: Int
    exponent: Int
    hi_mantissa: Int
    lo_mantissa: Int

type QuadSpecialKind = struct:
    is_finite: Bool
    is_infinite: Bool
    is_nan: Bool
    is_zero: Bool

pub fn quad_zero(sign: Int) -> QuadFloat:
    QuadFloat(sign % 2, 0, 0, 0)

pub fn quad_infinity(sign: Int) -> QuadFloat:
    QuadFloat(sign % 2, 32767, 0, 0)

pub fn quad_nan() -> QuadFloat:
    QuadFloat(0, 32767, 1, 0)

pub fn quad_classify(q: QuadFloat) -> QuadSpecialKind:
    if q.exponent == 32767:
        if q.hi_mantissa != 0:
            QuadSpecialKind(false, false, true, false)
        else:
            if q.lo_mantissa != 0:
                QuadSpecialKind(false, false, true, false)
            else:
                QuadSpecialKind(false, true, false, false)
    else:
        if q.exponent == 0:
            if q.hi_mantissa == 0:
                if q.lo_mantissa == 0:
                    QuadSpecialKind(true, false, false, true)
                else:
                    QuadSpecialKind(true, false, false, false)
            else:
                QuadSpecialKind(true, false, false, false)
        else:
            QuadSpecialKind(true, false, false, false)

pub fn quad_is_zero(q: QuadFloat) -> Bool:
    let c = quad_classify(q)
    c.is_zero

pub fn quad_is_nan(q: QuadFloat) -> Bool:
    let c = quad_classify(q)
    c.is_nan

pub fn quad_is_infinite(q: QuadFloat) -> Bool:
    let c = quad_classify(q)
    c.is_infinite

pub fn quad_is_finite(q: QuadFloat) -> Bool:
    let c = quad_classify(q)
    c.is_finite

pub fn quad_negate(q: QuadFloat) -> QuadFloat:
    if q.sign == 0:
        QuadFloat(1, q.exponent, q.hi_mantissa, q.lo_mantissa)
    else:
        QuadFloat(0, q.exponent, q.hi_mantissa, q.lo_mantissa)

pub fn quad_abs(q: QuadFloat) -> QuadFloat:
    QuadFloat(0, q.exponent, q.hi_mantissa, q.lo_mantissa)

pub fn quad_compare(a: QuadFloat, b: QuadFloat) -> Int:
    if a.sign != b.sign:
        if a.sign == 1:
            -1
        else:
            1
    else:
        if a.exponent != b.exponent:
            if a.exponent < b.exponent:
                if a.sign == 1:
                    1
                else:
                    -1
            else:
                if a.sign == 1:
                    -1
                else:
                    1
        else:
            if a.hi_mantissa != b.hi_mantissa:
                if a.hi_mantissa < b.hi_mantissa:
                    if a.sign == 1:
                        1
                    else:
                        -1
                else:
                    if a.sign == 1:
                        -1
                    else:
                        1
            else:
                if a.lo_mantissa < b.lo_mantissa:
                    if a.sign == 1:
                        1
                    else:
                        -1
                else:
                    if a.lo_mantissa > b.lo_mantissa:
                        if a.sign == 1:
                            -1
                        else:
                            1
                    else:
                        0

pub fn quad_eq(a: QuadFloat, b: QuadFloat) -> Bool:
    let diff = quad_compare(a, b)
    diff == 0

pub fn quad_lt(a: QuadFloat, b: QuadFloat) -> Bool:
    let diff = quad_compare(a, b)
    diff < 0

pub fn quad_gt(a: QuadFloat, b: QuadFloat) -> Bool:
    let diff = quad_compare(a, b)
    diff > 0

