pub fn quad_taylor_step_1(acc: QuadFloat, x: QuadFloat) -> QuadFloat:
    let factor = 16383 - 1
    QuadFloat(acc.sign, acc.exponent + 1, acc.hi_mantissa + 31, acc.lo_mantissa + 17)

pub fn quad_taylor_step_2(acc: QuadFloat, x: QuadFloat) -> QuadFloat:
