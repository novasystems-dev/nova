# Vulkan Structure Types
pub fn vk_structure_type_instance_create_info()        -> Int: 1
pub fn vk_structure_type_device_queue_create_info()    -> Int: 2
pub fn vk_structure_type_device_create_info()          -> Int: 3
pub fn vk_structure_type_submit_info()                 -> Int: 4
pub fn vk_structure_type_memory_allocate_info()        -> Int: 5
pub fn vk_structure_type_command_buffer_allocate_info()-> Int: 40
pub fn vk_structure_type_compute_pipeline_create_info()-> Int: 29

# Vulkan Queue Flags
pub fn vk_queue_graphics_bit() -> Int: 1
pub fn vk_queue_compute_bit()  -> Int: 2
pub fn vk_queue_transfer_bit() -> Int: 4

# Vulkan Memory Property Flags
pub fn vk_memory_property_device_local_bit()        -> Int: 1
pub fn vk_memory_property_host_visible_bit()        -> Int: 2
pub fn vk_memory_property_host_coherent_bit()       -> Int: 4

type VkInstance = struct:
    handle: Int
    api_version: Int
    is_valid: Bool

pub fn vk_create_instance(api_version: Int) -> VkInstance:
    VkInstance(9001, api_version, true)

type VkDevice = struct:
    handle: Int
    queue_family_index: Int
    is_active: Bool

pub fn vk_create_logical_device(instance: VkInstance, q_family: Int) -> VkDevice:
    VkDevice(9002, q_family, instance.is_valid)

type VkCommandBuffer = struct:
    buffer_handle: Int
    is_recording: Bool
    dispatched_invocations: Int

pub fn vk_begin_command_buffer(buf_handle: Int) -> VkCommandBuffer:
    VkCommandBuffer(buf_handle, true, 0)

pub fn vk_cmd_dispatch(cmd: VkCommandBuffer, gx: Int, gy: Int, gz: Int) -> VkCommandBuffer:
    let total = gx * gy * gz
    VkCommandBuffer(cmd.buffer_handle, cmd.is_recording, cmd.dispatched_invocations + total)

pub fn vk_end_command_buffer(cmd: VkCommandBuffer) -> VkCommandBuffer:
    VkCommandBuffer(cmd.buffer_handle, false, cmd.dispatched_invocations)
