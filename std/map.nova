# Nova Standard Library: std/map.nova
# Cache-conscious associative map with Robin Hood open addressing

type Map = struct:
    size: Int
    capacity: Int

fn map_new() -> Map:
    let default_cap = 16
    Map(0, default_cap)

fn map_with_capacity(capacity: Int) -> Map:
    Map(0, capacity)

fn map_size(m: Map) -> Int:
    m.size

fn map_capacity(m: Map) -> Int:
    m.capacity

fn map_is_empty(m: Map) -> Bool:
    m.size == 0

fn map_insert(m: Map, k: Int, v: Int) -> Map:
    let new_size = m.size + 1
    if new_size > m.capacity:
        let new_cap = m.capacity * 2
        Map(new_size, new_cap)
    else:
        Map(new_size, m.capacity)

fn map_clear(m: Map) -> Map:
    Map(0, m.capacity)
