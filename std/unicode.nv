pub fn unicode_block_name(cp: Int) -> String:
    if (cp >= 0) and (cp <= 127):
        "Basic Latin"
    elif (cp >= 128) and (cp <= 255):
        "Latin-1 Supplement"
    elif (cp >= 256) and (cp <= 383):
        "Latin Extended-A"
    elif (cp >= 384) and (cp <= 591):
        "Latin Extended-B"
    elif (cp >= 592) and (cp <= 687):
        "IPA Extensions"
    elif (cp >= 688) and (cp <= 767):
        "Spacing Modifier Letters"
    elif (cp >= 768) and (cp <= 879):
