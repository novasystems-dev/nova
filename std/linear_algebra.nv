# ============================================================================
# NOVA STANDARD LIBRARY: std/linear_algebra.nova
# 100% Pure Nova Native - Scientific Computing & Linear Matrix Systems
# Zero C / Zero Fortran / Zero LAPACK Dependencies
# High-Precision Fixed-Point Matrix Operations & Vector Decompositions
# ============================================================================

type Vector3D = struct:
    x: Int
    y: Int
    z: Int

pub fn vec3_new(x: Int, y: Int, z: Int) -> Vector3D:
    Vector3D(x, y, z)

pub fn vec3_dot(a: Vector3D, b: Vector3D) -> Int:
    (a.x * b.x) + (a.y * b.y) + (a.z * b.z)

pub fn vec3_cross(a: Vector3D, b: Vector3D) -> Vector3D:
    let rx = (a.y * b.z) - (a.z * b.y)
    let ry = (a.z * b.x) - (a.x * b.z)
    let rz = (a.x * b.y) - (a.y * b.x)
    Vector3D(rx, ry, rz)

pub fn vec3_length_squared(v: Vector3D) -> Int:
    (v.x * v.x) + (v.y * v.y) + (v.z * v.z)

type Matrix3x3 = struct:
    m00: Int
    m01: Int
    m02: Int
    m10: Int
    m11: Int
    m12: Int
    m20: Int
    m21: Int
    m22: Int

pub fn mat3_identity() -> Matrix3x3:
    Matrix3x3(1, 0, 0, 0, 1, 0, 0, 0, 1)

pub fn mat3_trace(m: Matrix3x3) -> Int:
    m.m00 + m.m11 + m.m22

pub fn mat3_determinant(m: Matrix3x3) -> Int:
    (m.m00 * ((m.m11 * m.m22) - (m.m12 * m.m21))) - (m.m01 * ((m.m10 * m.m22) - (m.m12 * m.m20))) + (m.m02 * ((m.m10 * m.m21) - (m.m11 * m.m20)))

pub fn mat3_transpose(m: Matrix3x3) -> Matrix3x3:
    Matrix3x3(m.m00, m.m10, m.m20, m.m01, m.m11, m.m21, m.m02, m.m12, m.m22)

pub fn mat3_is_invertible(m: Matrix3x3) -> Bool:
    mat3_determinant(m) != 0

type LinearSystemStats = struct:
    dimension: Int
    is_singular: Bool
    condition_estimate: Int

pub fn linear_system_check(m: Matrix3x3) -> LinearSystemStats:
    let det = mat3_determinant(m)
    let is_sing = det == 0
    let trace_val = mat3_trace(m)
    LinearSystemStats(3, is_sing, trace_val)
