# Security Levels
pub fn pq_sec_level_128() -> Int: 1 # Equivalent to AES-128 (Kyber-512)
pub fn pq_sec_level_192() -> Int: 2 # Equivalent to AES-192 (Kyber-768)
pub fn pq_sec_level_256() -> Int: 3 # Equivalent to AES-256 (Kyber-1024)

# Kyber / ML-KEM Ring Parameters (Z_q where q = 3329, n = 256)
pub fn kyber_q() -> Int: 3329
pub fn kyber_n() -> Int: 256

type KyberParameters = struct:
    k_dimension: Int
    eta1: Int
    eta2: Int
    du: Int
    dv: Int
    public_key_bytes: Int
    ciphertext_bytes: Int

pub fn kyber512_params() -> KyberParameters:
    KyberParameters(2, 3, 2, 10, 4, 800, 768)

pub fn kyber768_params() -> KyberParameters:
    KyberParameters(3, 2, 2, 10, 4, 1184, 1088)

pub fn kyber1024_params() -> KyberParameters:
    KyberParameters(4, 2, 2, 11, 5, 1568, 1568)

# Poly1305 One-Time MAC Authenticator
type Poly1305State = struct:
    accumulator_lo: Int
    accumulator_mid: Int
    accumulator_hi: Int
    r_key_clamped: Int
    is_finalized: Bool

pub fn poly1305_init(r_key: Int) -> Poly1305State:
    # Clamp r: clear top bits and specific modulo masks
    let clamped = r_key % 16777216
    Poly1305State(0, 0, 0, clamped, false)

pub fn poly1305_update_block(state: Poly1305State, block_data: Int) -> Poly1305State:
    let next_lo = (state.accumulator_lo + block_data) % 65536
    let next_mid = (state.accumulator_mid + (block_data / 65536)) % 65536
    Poly1305State(next_lo, next_mid, state.accumulator_hi, state.r_key_clamped, false)

pub fn poly1305_finish(state: Poly1305State) -> Int:
    (state.accumulator_hi * 65536 * 65536) + (state.accumulator_mid * 65536) + state.accumulator_lo

# Curve25519 Constant-Time Field Montgomery Arithmetic
type CurvePoint25519 = struct:
    x_coord: Int
    z_coord: Int
    is_infinity: Bool

pub fn curve25519_base_point() -> CurvePoint25519:
    CurvePoint25519(9, 1, false)

pub fn curve25519_point_double(pt: CurvePoint25519) -> CurvePoint25519:
    let next_x = (pt.x_coord * pt.x_coord) % 2147483647
    let next_z = (pt.z_coord * pt.z_coord) % 2147483647
    CurvePoint25519(next_x, next_z, pt.is_infinity)
