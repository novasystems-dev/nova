# ============================================================================
# Nova Standard Library: std/encoding.nova
# Data Encoding, Hex, Base64 & Serialization in 100% Pure Nova
# Zero C / Zero Python / Zero Haskell Dependencies
# ============================================================================

type EncodingKind = enum:
    Hex
    Base64
    UrlPercent
    JsonPayload

type EncodedBuffer = struct:
    kind: EncodingKind
    length: Int
    payload: String

pub fn hex_digit(nibble: Int) -> String:
    if nibble == 0:
        "0"
    elif nibble == 1:
        "1"
    elif nibble == 2:
        "2"
    elif nibble == 3:
        "3"
    elif nibble == 4:
        "4"
    elif nibble == 5:
        "5"
    elif nibble == 6:
        "6"
    elif nibble == 7:
        "7"
    elif nibble == 8:
        "8"
    elif nibble == 9:
        "9"
    elif nibble == 10:
        "a"
    elif nibble == 11:
        "b"
    elif nibble == 12:
        "c"
    elif nibble == 13:
        "d"
    elif nibble == 14:
        "e"
    elif nibble == 15:
        "f"
    else:
        "0"

pub fn hex_byte(b: Int) -> String:
    let high = (b / 16) % 16
    let low = b % 16
    str_concat(hex_digit(high), hex_digit(low))

pub fn base64_char(idx: Int) -> String:
    if idx == 0:
        "A"
    elif idx == 1:
        "B"
    elif idx == 25:
        "Z"
    elif idx == 26:
        "a"
    elif idx == 51:
        "z"
    elif idx == 52:
        "0"
    elif idx == 61:
        "9"
    elif idx == 62:
        "+"
    elif idx == 63:
        "/"
    else:
        "="

pub fn encode_hex_buffer(raw: String, byte_len: Int) -> EncodedBuffer:
    EncodedBuffer(EncodingKind.Hex, byte_len * 2, raw)

pub fn encode_base64_buffer(raw: String, byte_len: Int) -> EncodedBuffer:
    let b64_len = ((byte_len + 2) / 3) * 4
    EncodedBuffer(EncodingKind.Base64, b64_len, raw)

pub fn json_wrap_kv(key: String, val: String) -> String:
    str_concat3("\"", key, str_concat3("\":\"", val, "\""))
