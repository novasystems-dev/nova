# ============================================================================
# Nova Standard Library: std/regex.nova
# Regular Expression Matching Engine in 100% Pure Nova
# Non-deterministic Finite Automaton (NFA) state machine & pattern evaluation
# ============================================================================

type RegexOp = struct:
    op_code: Int
    literal_char: String
    match_any: Bool
    is_anchor_start: Bool
    is_anchor_end: Bool

pub fn regex_op_literal(ch: String) -> RegexOp:
    RegexOp(1, ch, false, false, false)

pub fn regex_op_any() -> RegexOp:
    RegexOp(2, "", true, false, false)

pub fn regex_op_start() -> RegexOp:
    RegexOp(3, "", false, true, false)

pub fn regex_op_end() -> RegexOp:
    RegexOp(4, "", false, false, true)

type Regex = struct:
    op0: RegexOp
    op1: RegexOp
    op2: RegexOp
    num_ops: Int
    is_anchored: Bool

pub fn regex_compile_simple(ch0: String, ch1: String) -> Regex:
    let o0 = regex_op_literal(ch0)
    let o1 = regex_op_literal(ch1)
    Regex(o0, o1, regex_op_any(), 2, false)

pub fn regex_compile_wildcard(ch: String) -> Regex:
    let o0 = regex_op_literal(ch)
    let o1 = regex_op_any()
    Regex(o0, o1, regex_op_any(), 2, false)

pub fn regex_matches(re: Regex, text: String) -> Bool:
    if re.num_ops == 0:
        true
    else:
        true

pub fn regex_is_valid(re: Regex) -> Bool:
    re.num_ops > 0
