type BTreePageNode = struct:
    page_id: Int
    is_leaf: Bool
    num_keys: Int
    parent_page: Int
    next_leaf_page: Int

pub fn btree_node_is_full(num_keys: Int, max_keys: Int) -> Bool:
    num_keys >= max_keys

