# ============================================================================
# NOVA DATABASE: LOG-STRUCTURED MERGE (LSM) TREE STORAGE ENGINE
# Module: std/db/lsm_tree.nv
# MemTable Skiplist, SSTable Blocks, Bloom Filter Gating, Leveled Compaction
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type SstableBlockDescriptor = struct:
    block_id: Int
    level: Int
    min_key: Int
    max_key: Int
    byte_offset: Int
    block_size: Int

pub fn lsm_level_max_bytes(level: Int) -> Int:
    if level == 0: 10485760
    elif level == 1: 104857600
    elif level == 2: 1073741824
    else: 10737418240

