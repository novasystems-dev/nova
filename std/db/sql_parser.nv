# ============================================================================
# NOVA DATABASE: ANSI SQL QUERY PARSER & AST NODES
# Module: std/db/sql_parser.nv
# Lexical Tokenizer, Query Plan Cost Model, Relational Operators
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type SqlTokenEntry = struct:
    id: Int
    token_kind: Int
    literal: String
    is_keyword: Bool

pub fn sql_resolve_kind_name(k: Int) -> String:
    if k == 1: "SELECT"
    elif k == 2: "FROM"
    elif k == 3: "WHERE"
    elif k == 4: "INSERT"
    elif k == 5: "UPDATE"
    elif k == 6: "DELETE"
    elif k == 7: "JOIN"
    elif k == 8: "GROUP_BY"
    elif k == 9: "ORDER_BY"
    else: "IDENTIFIER"

pub fn sql_token_rule_1() -> SqlTokenEntry:
    SqlTokenEntry(1, 2, sql_resolve_kind_name(2), true)

pub fn sql_token_rule_2() -> SqlTokenEntry:
    SqlTokenEntry(2, 3, sql_resolve_kind_name(3), true)

