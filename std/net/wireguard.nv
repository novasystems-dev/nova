# ============================================================================
# NOVA NETWORKING: WIREGUARD VPN PROTOCOL SPECIFICATION
# Module: std/net/wireguard.nv
# Noise_IKpsk2 Handshake Framing, Cookie Reply, Transport Encapsulation
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type WireguardMessage = struct:
    id: Int
    msg_type: Int
    sender_index: Int
    receiver_index: Int
    counter: Int

pub fn wireguard_resolve_type_name(t: Int) -> String:
    if t == 1: "INITIATION"
    elif t == 2: "RESPONSE"
    elif t == 3: "COOKIE"
    elif t == 4: "DATA"
    else: "UNKNOWN"

pub fn wg_msg_entry_1() -> WireguardMessage:
    WireguardMessage(1, 2, 7, 11, 100)

