# ============================================================================
# NOVA NETWORKING: RFC 5280 X.509 ASN.1 DER CERTIFICATE PARSER
# Module: std/net/x509_cert.nv
# ASN.1 Tag/Length/Value Decoders, Distinguished Names, Extensions
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type X509ExtensionEntry = struct:
    id: Int
    oid_name: String
    is_critical: Bool
    value_len: Int

pub fn x509_parse_asn1_tag(tag_byte: Int) -> String:
    if tag_byte == 48: "SEQUENCE"
    elif tag_byte == 49: "SET"
    elif tag_byte == 2: "INTEGER"
    elif tag_byte == 3: "BIT_STRING"
    elif tag_byte == 4: "OCTET_STRING"
    elif tag_byte == 6: "OBJECT_IDENTIFIER"
    elif tag_byte == 12: "UTF8_STRING"
    else: "OTHER"

pub fn x509_ext_entry_1() -> X509ExtensionEntry:
    X509ExtensionEntry(1, "keyUsage_1", false, 8)

