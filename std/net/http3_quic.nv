# ============================================================================
# NOVA NETWORKING: RFC 9000 QUIC & RFC 9114 HTTP/3 TRANSPORT
# Module: std/net/http3_quic.nv
# Packet Framing, Connection Flow Control, Multiplexed Streams
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type QuicFrameEntry = struct:
    id: Int
    frame_type: Int
    name: String
    stream_id: Int
    payload_size: Int

pub fn quic_resolve_frame_name(ft: Int) -> String:
    if ft == 0: "PADDING"
    elif ft == 1: "PING"
    elif ft == 2: "ACK"
    elif ft == 4: "RESET_STREAM"
    elif ft == 6: "CRYPTO"
    elif ft == 8: "STREAM"
    elif ft == 16: "MAX_DATA"
    else: "UNKNOWN"

pub fn quic_frame_entry_1() -> QuicFrameEntry:
    QuicFrameEntry(1, 1, quic_resolve_frame_name(1), 4, 64)

pub fn quic_frame_entry_2() -> QuicFrameEntry:
    QuicFrameEntry(2, 2, quic_resolve_frame_name(2), 8, 128)

