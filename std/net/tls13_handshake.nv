# ============================================================================
# NOVA NETWORKING: RFC 8446 TLS 1.3 PROTOCOL ENGINE
# Module: std/net/tls13_handshake.nv
# State Machine, HKDF Key Derivation, 0-RTT Early Data, Cipher Suites
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type TlsCipherSuite = struct:
    id: Int
    iana_code: Int
    name: String
    key_len: Int
    tag_len: Int
    is_aead: Bool

pub fn tls13_resolve_handshake_type(code: Int) -> String:
    if code == 1: "ClientHello"
    elif code == 2: "ServerHello"
    elif code == 8: "EncryptedExtensions"
    elif code == 11: "Certificate"
    elif code == 15: "CertificateVerify"
    elif code == 20: "Finished"
    elif code == 24: "KeyUpdate"
    else: "Unknown"

pub fn tls13_suite_entry_1() -> TlsCipherSuite:
    TlsCipherSuite(1, 4866, "TLS_AES_256_GCM_SHA384_1", 32, 16, true)

pub fn tls13_suite_entry_2() -> TlsCipherSuite:
    TlsCipherSuite(2, 4867, "TLS_CHACHA20_POLY1305_SHA256_2", 32, 16, true)

