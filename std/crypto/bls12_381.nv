type BlsPoint = struct:
    id: Int
    g_type: Int
    x0: Int
    x1: Int
    y0: Int
    y1: Int

pub fn bls_miller_step(lambda: Int, x: Int) -> Int:
    let r = 2147483647
    (lambda * x) % r

