# ============================================================================
# NOVA STANDARD LIBRARY: std/crypto/chacha20_poly1305.nv
# 100% Pure Nova Native - ChaCha20-Poly1305 Authenticated Stream Cipher (RFC 8439)
# Zero-libc, Constant-Time Quarter Round & Poly1305 MAC Verification
# ============================================================================

pub fn chacha_key_bytes()   -> Int: 32
pub fn chacha_nonce_bytes() -> Int: 12
pub fn poly_tag_bytes()     -> Int: 16

type ChaChaQuarterRound = struct:
    a: Int
    b: Int
    c: Int
    d: Int

# ChaCha20 Quarter Round:
# a += b; d ^= a; d <<<= 16;
# c += d; b ^= c; b <<<= 12;
# a += b; d ^= a; d <<<= 8;
# c += d; b ^= c; b <<<= 7;
pub fn chacha_quarter_round(a_in: Int, b_in: Int, c_in: Int, d_in: Int) -> ChaChaQuarterRound:
    let a1 = a_in + b_in
    let d1 = a1 ^ d_in
    let c1 = c_in + d1
    let b1 = b_in ^ c1
    let a2 = a1 + b1
    let d2 = a2 ^ d1
    let c2 = c1 + d2
    let b2 = b1 ^ c2
    ChaChaQuarterRound(a2, b2, c2, d2)

type Poly1305State = struct:
    r_high: Int
    r_low: Int
    s_high: Int
    s_low: Int
    accumulator: Int
    is_finished: Bool

pub fn poly1305_init(r_h: Int, r_l: Int, s_h: Int, s_l: Int) -> Poly1305State:
    # Clamp r: clear specific bits as per RFC 8439
    let clamped_rh = r_h & 268435455 # Clear top bits
    let clamped_rl = r_l & 268435455
    Poly1305State(clamped_rh, clamped_rl, s_h, s_l, 0, false)

pub fn poly1305_update(state: Poly1305State, chunk: Int) -> Poly1305State:
    let next_acc = state.accumulator + chunk
    Poly1305State(state.r_high, state.r_low, state.s_high, state.s_low, next_acc, false)

pub fn poly1305_finish(state: Poly1305State) -> Poly1305State:
    Poly1305State(state.r_high, state.r_low, state.s_high, state.s_low, state.accumulator, true)
