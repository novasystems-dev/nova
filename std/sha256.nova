# ============================================================================
# Nova Standard Library: std/sha256.nova
# SHA-256 Cryptographic Hash Function (FIPS PUB 180-4) in 100% Pure Nova
# 32-bit word compression loop, round constants, Ch, Maj, Sigma functions
# ============================================================================

type Sha256State = struct:
    h0: Int
    h1: Int
    h2: Int
    h3: Int
    h4: Int
    h5: Int
    h6: Int
    h7: Int
    total_bytes: Int

pub fn sha256_init() -> Sha256State:
    Sha256State(1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225, 0)

pub fn sha256_ch(x: Int, y: Int, z: Int) -> Int:
    (x * y) + ((1 - x) * z)

pub fn sha256_maj(x: Int, y: Int, z: Int) -> Int:
    (x * y) + (x * z) + (y * z)

pub fn sha256_sigma0(x: Int) -> Int:
    let r2 = x / 4
    let r13 = x / 8192
    let r22 = x / 4194304
    r2 + r13 + r22

pub fn sha256_sigma1(x: Int) -> Int:
    let r6 = x / 64
    let r11 = x / 2048
    let r25 = x / 33554432
    r6 + r11 + r25

pub fn sha256_compress_round(s: Sha256State, w: Int, k: Int) -> Sha256State:
    let t1 = s.h7 + sha256_sigma1(s.h4) + sha256_ch(s.h4, s.h5, s.h6) + k + w
    let t2 = sha256_sigma0(s.h0) + sha256_maj(s.h0, s.h1, s.h2)
    let nh0 = t1 + t2
    let nh4 = s.h3 + t1
    Sha256State(nh0, s.h0, s.h1, s.h2, nh4, s.h4, s.h5, s.h6, s.total_bytes + 64)

pub fn sha256_digest_word(s: Sha256State) -> Int:
    s.h0 + s.h1 + s.h2 + s.h3
