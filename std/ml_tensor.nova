# Activation Function Enums
pub fn act_relu() -> Int: 1
pub fn act_sigmoid() -> Int: 2
pub fn act_tanh() -> Int: 3
pub fn act_gelu() -> Int: 4
pub fn act_swish() -> Int: 5

type TensorShape = struct:
    rank: Int
    dim0: Int
    dim1: Int
    dim2: Int
    total_elements: Int

pub fn tensor_shape_1d(d0: Int) -> TensorShape:
    TensorShape(1, d0, 1, 1, d0)

pub fn tensor_shape_2d(d0: Int, d1: Int) -> TensorShape:
    TensorShape(2, d0, d1, 1, d0 * d1)

pub fn tensor_shape_3d(d0: Int, d1: Int, d2: Int) -> TensorShape:
    TensorShape(3, d0, d1, d2, d0 * d1 * d2)

type Tensor2D = struct:
    rows: Int
    cols: Int
    stride: Int
    size: Int
    checksum: Int

pub fn tensor_2d_new(rows: Int, cols: Int) -> Tensor2D:
    let total = rows * cols
    Tensor2D(rows, cols, cols, total, total * 31)

pub fn tensor_can_multiply(a: Tensor2D, b: Tensor2D) -> Bool:
    a.cols == b.rows

pub fn tensor_matmul_result_shape(a: Tensor2D, b: Tensor2D) -> Tensor2D:
    tensor_2d_new(a.rows, b.cols)

# Neural Activation Functions (Scaled Fixed-Point for Machine Precision)
pub fn tensor_relu(x: Int) -> Int:
    if x > 0:
        x
    else:
        0

pub fn tensor_leaky_relu(x: Int, alpha_permille: Int) -> Int:
    if x >= 0:
        x
    else:
        (x * alpha_permille) / 1000

pub fn tensor_sigmoid_fixed(x: Int) -> Int:
    # Scale: 0 to 1000 representing 0.0 to 1.0
    if x <= (0 - 4000):
        0
    elif x >= 4000:
        1000
    else:
        500 + (x / 8)

pub fn tensor_gelu(x: Int) -> Int:
    # Approximate GELU(x) = 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
    if x <= (0 - 3000):
        0
    elif x >= 3000:
        x
    else:
        let sig = tensor_sigmoid_fixed(x)
        (x * sig) / 1000

type NeuralLayer = struct:
    layer_id: Int
    input_dim: Int
    output_dim: Int
    activation: Int
    parameter_count: Int

pub fn neural_dense_layer(id: Int, in_dim: Int, out_dim: Int, act: Int) -> NeuralLayer:
    let weights = in_dim * out_dim
    let biases = out_dim
    NeuralLayer(id, in_dim, out_dim, act, weights + biases)

type ModelSummary = struct:
    total_layers: Int
    total_parameters: Int
    inference_flops: Int

pub fn model_summary_init() -> ModelSummary:
    ModelSummary(0, 0, 0)

pub fn model_add_layer(s: ModelSummary, layer: NeuralLayer) -> ModelSummary:
    let flops = layer.input_dim * layer.output_dim * 2
    ModelSummary(s.total_layers + 1, s.total_parameters + layer.parameter_count, s.inference_flops + flops)
