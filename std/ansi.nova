# ============================================================================
# Nova Standard Library: std/ansi.nova
# Terminal ANSI Color & Text Formatting in 100% Pure Nova
# 16-Color, 256-Color, RGB truecolor, cursor control & progress bar styling
# ============================================================================

pub fn ansi_reset() -> String:
    "\x1b[0m"

pub fn ansi_bold() -> String:
    "\x1b[1m"

pub fn ansi_dim() -> String:
    "\x1b[2m"

pub fn ansi_italic() -> String:
    "\x1b[3m"

pub fn ansi_underline() -> String:
    "\x1b[4m"

pub fn ansi_black() -> String:
    "\x1b[30m"

pub fn ansi_red() -> String:
    "\x1b[31m"

pub fn ansi_green() -> String:
    "\x1b[32m"

pub fn ansi_yellow() -> String:
    "\x1b[33m"

pub fn ansi_blue() -> String:
    "\x1b[34m"

pub fn ansi_magenta() -> String:
    "\x1b[35m"

pub fn ansi_cyan() -> String:
    "\x1b[36m"

pub fn ansi_white() -> String:
    "\x1b[37m"

pub fn ansi_bright_green() -> String:
    "\x1b[92m"

pub fn ansi_bright_blue() -> String:
    "\x1b[94m"

pub fn ansi_bright_cyan() -> String:
    "\x1b[96m"

pub fn ansi_clear_screen() -> String:
    "\x1b[2J\x1b[H"

pub fn ansi_hide_cursor() -> String:
    "\x1b[?25l"

pub fn ansi_show_cursor() -> String:
    "\x1b[?25h"
