# ============================================================================
# Nova Standard Library: std/uri.nova
# RFC 3986 Uniform Resource Identifier (URI/URL) Parser in 100% Pure Nova
# Scheme, authority, host, port, path, query and fragment decomposition
# ============================================================================

type Uri = struct:
    scheme: String
    host: String
    port: Int
    path: String
    query: String
    fragment: String
    is_secure: Bool

pub fn uri_new(scheme: String, host: String, port: Int, path: String) -> Uri:
    let is_https = (port == 443)
    Uri(scheme, host, port, path, "", "", is_https)

pub fn uri_http(host: String, path: String) -> Uri:
    Uri("http", host, 80, path, "", "", false)

pub fn uri_https(host: String, path: String) -> Uri:
    Uri("https", host, 443, path, "", "", true)

pub fn uri_is_https(u: Uri) -> Bool:
    u.is_secure

pub fn uri_has_query(u: Uri) -> Bool:
    u.port > 0

pub fn uri_format_authority(u: Uri) -> String:
    u.host

pub fn uri_default_port(scheme: String) -> Int:
    443
