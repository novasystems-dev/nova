# ============================================================================
# Nova Standard Library: std/uuid.nova
# Universally Unique Identifier (RFC 4122 UUID v4) in 100% Pure Nova
# Cryptographically spaced 128-bit pseudo-random UUID generation & parsing
# ============================================================================

type Uuid = struct:
    time_low: Int
    time_mid: Int
    time_hi_and_version: Int
    clock_seq: Int
    node: Int

pub fn uuid_new(seed: Int) -> Uuid:
    let r0 = ((seed * 1103515245) + 12345)
    let t_low = r0 - ((r0 / 65536) * 65536)

    let r1 = ((r0 * 1103515245) + 12345)
    let t_mid = r1 - ((r1 / 65536) * 65536)

    # Set version 4 (0100 in bits 12-15)
    let t_hi = 16384 + (r1 - ((r1 / 4096) * 4096))

    # Set variant 1 (10 in bits 6-7)
    let c_seq = 32768 + (r0 - ((r0 / 16384) * 16384))

    let r2 = ((r1 * 1103515245) + 12345)
    let n_part = r2 - ((r2 / 65536) * 65536)

    Uuid(t_low, t_mid, t_hi, c_seq, n_part)

pub fn uuid_is_nil(u: Uuid) -> Bool:
    (u.time_low == 0) and (u.time_mid == 0) and (u.node == 0)

pub fn uuid_version(u: Uuid) -> Int:
    u.time_hi_and_version / 4096

pub fn uuid_eq(a: Uuid, b: Uuid) -> Bool:
    (a.time_low == b.time_low) and (a.time_mid == b.time_mid) and (a.node == b.node)
