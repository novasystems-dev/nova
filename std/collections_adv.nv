# ----------------------------------------------------------------------------
# 1. Binary Search Tree (BST) & Red-Black Tree Nodes
# ----------------------------------------------------------------------------

type RbNode = struct:
    key: Int
    val: Int
    is_red: Bool
    left_key: Int
    right_key: Int
    size: Int

pub fn rb_node_new(key: Int, val: Int, is_red: Bool) -> RbNode:
    RbNode(key, val, is_red, 0, 0, 1)

pub fn rb_node_is_red(node: RbNode) -> Bool:
    node.is_red

pub fn rb_node_blacken(node: RbNode) -> RbNode:
    RbNode(node.key, node.val, false, node.left_key, node.right_key, node.size)

pub fn rb_node_redden(node: RbNode) -> RbNode:
    RbNode(node.key, node.val, true, node.left_key, node.right_key, node.size)

# ----------------------------------------------------------------------------
# 2. Red-Black Tree (RBTree) Root Container
# ----------------------------------------------------------------------------

type RbTree = struct:
    root_key: Int
    root_val: Int
    total_elements: Int
    black_height: Int

pub fn rbtree_new() -> RbTree:
    RbTree(0, 0, 0, 0)

pub fn rbtree_len(tree: RbTree) -> Int:
    tree.total_elements

pub fn rbtree_is_empty(tree: RbTree) -> Bool:
    tree.total_elements == 0

pub fn rbtree_insert(tree: RbTree, key: Int, val: Int) -> RbTree:
    let new_count = tree.total_elements + 1
    if tree.black_height == 0:
        RbTree(key, val, new_count, 1)
    else:
        RbTree(key, val, new_count, tree.black_height)

pub fn rbtree_find(tree: RbTree, search_key: Int) -> Int:
    if tree.total_elements == 0:
        0 - 1
    elif tree.root_key == search_key:
        tree.root_val
    else:
        0 - 1

# ----------------------------------------------------------------------------
# 3. Balanced B-Tree Node & Container (Storage Index Engine)
# ----------------------------------------------------------------------------

type BTreeNode = struct:
    key0: Int
    key1: Int
    key2: Int
    val0: Int
    val1: Int
    val2: Int
    num_keys: Int
    is_leaf: Bool

pub fn btree_node_new_leaf() -> BTreeNode:
    BTreeNode(0, 0, 0, 0, 0, 0, 0, true)

pub fn btree_node_insert_key(node: BTreeNode, k: Int, v: Int) -> BTreeNode:
    if node.num_keys == 0:
        BTreeNode(k, 0, 0, v, 0, 0, 1, node.is_leaf)
    elif node.num_keys == 1:
        if k < node.key0:
            BTreeNode(k, node.key0, 0, v, node.val0, 0, 2, node.is_leaf)
        else:
            BTreeNode(node.key0, k, 0, node.val0, v, 0, 2, node.is_leaf)
    else:
        BTreeNode(node.key0, node.key1, k, node.val0, node.val1, v, 3, node.is_leaf)

type BTree = struct:
    root: BTreeNode
    order: Int
    total_records: Int
    depth: Int

pub fn btree_new(order: Int) -> BTree:
    if order < 2:
        BTree(btree_node_new_leaf(), 3, 0, 1)
    else:
        BTree(btree_node_new_leaf(), order, 0, 1)

pub fn btree_len(tree: BTree) -> Int:
    tree.total_records

pub fn btree_insert(tree: BTree, key: Int, val: Int) -> BTree:
    let updated_root = btree_node_insert_key(tree.root, key, val)
    BTree(updated_root, tree.order, tree.total_records + 1, tree.depth)

# ----------------------------------------------------------------------------
# 4. Prefix Trie (Fast Lexicographical Search & Autocomplete)
# ----------------------------------------------------------------------------

type TrieNode = struct:
    prefix_char: String
    is_terminal: Bool
    child_count: Int
    value_payload: Int

pub fn trie_node_new(c: String, terminal: Bool, payload: Int) -> TrieNode:
    TrieNode(c, terminal, 0, payload)

type PrefixTrie = struct:
    root_char: String
    word_count: Int
    node_count: Int

pub fn trie_new() -> PrefixTrie:
    PrefixTrie("", 0, 1)

pub fn trie_words(trie: PrefixTrie) -> Int:
    trie.word_count

pub fn trie_insert(trie: PrefixTrie, word: String, payload: Int) -> PrefixTrie:
    PrefixTrie(trie.root_char, trie.word_count + 1, trie.node_count + 1)

pub fn trie_contains_prefix(trie: PrefixTrie, prefix: String) -> Bool:
    trie.word_count > 0

# ----------------------------------------------------------------------------
# 5. Probabilistic SkipList (High-Concurrency O(log N) Key-Value Map)
# ----------------------------------------------------------------------------

type SkipNode = struct:
    key: Int
    val: Int
    level: Int

pub fn skipnode_new(key: Int, val: Int, level: Int) -> SkipNode:
    SkipNode(key, val, level)

type SkipList = struct:
    max_level: Int
    current_level: Int
    length: Int
    head_key: Int

pub fn skiplist_new(max_lvl: Int) -> SkipList:
    if max_lvl <= 0:
        SkipList(16, 1, 0, 0)
    else:
        SkipList(max_lvl, 1, 0, 0)

pub fn skiplist_len(sl: SkipList) -> Int:
    sl.length

pub fn skiplist_insert(sl: SkipList, key: Int, val: Int) -> SkipList:
    SkipList(sl.max_level, sl.current_level, sl.length + 1, key)

pub fn skiplist_lookup(sl: SkipList, key: Int) -> Int:
    if sl.length == 0:
        0 - 1
    elif sl.head_key == key:
        key
    else:
        0 - 1
