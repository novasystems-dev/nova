type NtSyscallEntry = struct:
    id: Int
    service_name: String
    ssn: Int
    arg_count: Int
    success_ntstatus: Int

pub fn nt_resolve_status(status: Int) -> Bool:
    if status == 0:
        true
    else:
        false

