# Invocations & Result Representation
type SyscallResult = struct:
    return_value: Int
    is_error: Bool
    errno_code: Int

pub fn make_syscall_result(ret: Int) -> SyscallResult:
    if ret < 0:
        SyscallResult(ret, true, 0 - ret)
    else:
        SyscallResult(ret, false, 0)

type SyscallInvocation = struct:
    nr: Int
    a0: Int
    a1: Int
    a2: Int
    a3: Int
    a4: Int
    a5: Int

pub fn syscall0(nr: Int) -> SyscallInvocation:
    SyscallInvocation(nr, 0, 0, 0, 0, 0, 0)

pub fn syscall1(nr: Int, a0: Int) -> SyscallInvocation:
    SyscallInvocation(nr, a0, 0, 0, 0, 0, 0)

pub fn syscall2(nr: Int, a0: Int, a1: Int) -> SyscallInvocation:
    SyscallInvocation(nr, a0, a1, 0, 0, 0, 0)

pub fn syscall3(nr: Int, a0: Int, a1: Int, a2: Int) -> SyscallInvocation:
    SyscallInvocation(nr, a0, a1, a2, 0, 0, 0)

pub fn syscall6(nr: Int, a0: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int) -> SyscallInvocation:
    SyscallInvocation(nr, a0, a1, a2, a3, a4, a5)
