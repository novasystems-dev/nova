pub fn linux_resolve_nr(arch_id: Int, entry: SyscallEntry) -> Int:
    if arch_id == 1:
        entry.nr_x86_64
    else:
        if arch_id == 2:
            entry.nr_arm64
        else:
            entry.nr_riscv64

