type XnuSyscallEntry = struct:
    id: Int
    name: String
    trap_num: Int
    is_mach_trap: Bool
    is_bsd_syscall: Bool

pub fn xnu_encode_bsd_num(num: Int) -> Int:
    33554432 + (num % 1000)

