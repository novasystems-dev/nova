# Windows Virtual Memory Allocation Flags
pub fn mem_commit() -> Int: 4096
pub fn mem_reserve() -> Int: 8192
pub fn mem_release() -> Int: 32768

# Windows Page Protection Constants
pub fn page_noaccess() -> Int: 1
pub fn page_readonly() -> Int: 2
pub fn page_readwrite() -> Int: 4
pub fn page_execute_readwrite() -> Int: 64

# Standard Device Handle IDs
pub fn std_input_handle() -> Int: 0 - 10
pub fn std_output_handle() -> Int: 0 - 11
pub fn std_error_handle() -> Int: 0 - 12

# File Access Modes
pub fn generic_read() -> Int: 2147483648
pub fn generic_write() -> Int: 1073741824
pub fn file_share_read() -> Int: 1
pub fn file_share_write() -> Int: 2
pub fn create_always() -> Int: 2
pub fn open_existing() -> Int: 3

type Win32Handle = struct:
    handle_val: Int
    is_valid: Bool

pub fn win32_make_handle(val: Int) -> Win32Handle:
    if val != 0 and val != (0 - 1):
        Win32Handle(val, true)
    else:
        Win32Handle(val, false)

type Win32MemoryPage = struct:
    base_address: Int
    size_bytes: Int
    is_committed: Bool

pub fn win32_alloc_virtual(size_bytes: Int) -> Win32MemoryPage:
    let rem = size_bytes % 65536
    if rem == 0:
        let base_addr = 536870912 + (size_bytes % 16777216)
        Win32MemoryPage(base_addr, size_bytes, true)
    else:
        let aligned = (size_bytes / 65536 + 1) * 65536
        let base_addr = 536870912 + (aligned % 16777216)
        Win32MemoryPage(base_addr, aligned, true)

pub fn win32_free_virtual(page: Win32MemoryPage) -> Bool:
    page.base_address != 0 and page.size_bytes > 0

type Win32ThreadContext = struct:
    thread_id: Int
    stack_base: Int
    is_running: Bool

pub fn win32_spawn_thread(tid: Int, stack_size: Int) -> Win32ThreadContext:
    let stack_base = 805306368 + (tid * 65536)
    Win32ThreadContext(tid, stack_base, true)

pub fn win32_join_thread(ctx: Win32ThreadContext) -> Bool:
    ctx.is_running
