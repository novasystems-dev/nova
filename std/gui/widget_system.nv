type WidgetNode = struct:
    id: Int
    kind: Int
    name: String
    width: Int
    height: Int
    is_visible: Bool

pub fn widget_resolve_kind_name(k: Int) -> String:
    if k == 1: "BOX"
    elif k == 2: "BUTTON"
    elif k == 3: "TEXT"
    elif k == 4: "SCROLL_VIEW"
    elif k == 5: "TEXT_INPUT"
    else: "CANVAS"

pub fn widget_node_entry_1() -> WidgetNode:
    WidgetNode(1, 2, widget_resolve_kind_name(2), 10, 5, true)

pub fn widget_node_entry_2() -> WidgetNode:
    WidgetNode(2, 3, widget_resolve_kind_name(3), 20, 10, true)

