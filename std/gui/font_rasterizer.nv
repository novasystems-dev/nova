# ============================================================================
# NOVA GUI: TRUETYPE / OPENTYPE FONT RASTERIZER
# Module: std/gui/font_rasterizer.nv
# Quadratic Bézier Curves, TTF Glyph Decoders, Antialiasing Coverage
# 100% Pure Nova Native - Zero C / Zero LLVM Dependencies
# ============================================================================

type GlyphContourPoint = struct:
    point_id: Int
    x: Int
    y: Int
    on_curve: Bool

pub fn font_eval_bezier_quadratic(p0: Int, p1: Int, p2: Int, t_percent: Int) -> Int:
    let u = 100 - t_percent
    let term0 = (u * u * p0) / 10000
    let term1 = (2 * u * t_percent * p1) / 10000
    let term2 = (t_percent * t_percent * p2) / 10000
    term0 + term1 + term2

pub fn font_glyph_point_1() -> GlyphContourPoint:
    GlyphContourPoint(1, 13, 29, false)

