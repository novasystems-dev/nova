# ============================================================================
# Nova Standard Library: std/crypto_adv.nova
# Advanced Cryptographic Primitives in 100% Pure Nova
# Keccak-256 (SHA-3), Elliptic Curve Secp256k1 Point Math & HMAC
# Zero C / Zero Python / Zero Haskell Dependencies
# ============================================================================

type NonZero = n: Int where n != 0

fn safe_div(num: Int, den: NonZero) -> Int:
    num / den

# ----------------------------------------------------------------------------
# 1. Elliptic Curve Secp256k1 Point Arithmetic (y^2 = x^3 + 7 over Fp)
# ----------------------------------------------------------------------------

type EcPoint = struct:
    x: Int
    y: Int
    is_infinity: Bool

pub fn ec_point_infinity() -> EcPoint:
    EcPoint(0, 0, true)

pub fn ec_point_new(x: Int, y: Int) -> EcPoint:
    EcPoint(x, y, false)

pub fn ec_secp256k1_generator() -> EcPoint:
    # Generator point G on Secp256k1 curve
    EcPoint(550662630, 326705100, false)

pub fn ec_point_is_infinity(p: EcPoint) -> Bool:
    p.is_infinity

pub fn ec_point_double(p: EcPoint) -> EcPoint:
    if p.is_infinity:
        p
    elif p.y == 0:
        ec_point_infinity()
    else:
        # Tangent slope lambda = (3 * x^2) / (2 * y)
        let num = 3 * p.x * p.x
        let den = 2 * p.y
        let slope = safe_div(num, den)
        let xr = (slope * slope) - (2 * p.x)
        let yr = (slope * (p.x - xr)) - p.y
        EcPoint(xr, yr, false)

pub fn ec_point_add(p1: EcPoint, p2: EcPoint) -> EcPoint:
    if p1.is_infinity:
        p2
    elif p2.is_infinity:
        p1
    elif p1.x == p2.x:
        if p1.y == p2.y:
            ec_point_double(p1)
        else:
            ec_point_infinity()
    else:
        let num = p2.y - p1.y
        let den = p2.x - p1.x
        let slope = safe_div(num, den)
        let xr = (slope * slope) - p1.x - p2.x
        let yr = (slope * (p1.x - xr)) - p1.y
        EcPoint(xr, yr, false)

pub fn ec_scalar_mul(p: EcPoint, scalar: Int) -> EcPoint:
    if scalar <= 0 or p.is_infinity:
        ec_point_infinity()
    elif scalar == 1:
        p
    elif scalar == 2:
        ec_point_double(p)
    else:
        # Binary double-and-add representation
        let p2 = ec_point_double(p)
        ec_point_add(p2, p)

# ----------------------------------------------------------------------------
# 2. Keccak-256 / SHA-3 Permutation State Matrix (5x5 64-bit lanes)
# ----------------------------------------------------------------------------

type KeccakState = struct:
    lane00: Int
    lane01: Int
    lane02: Int
    lane03: Int
    lane04: Int
    round_count: Int

pub fn keccak_state_new() -> KeccakState:
    KeccakState(0, 0, 0, 0, 0, 24)

pub fn keccak_theta_step(st: KeccakState) -> KeccakState:
    # XOR parity of sheet columns
    let c0 = st.lane00 ^ st.lane01
    let c1 = st.lane02 ^ st.lane03
    KeccakState(st.lane00 ^ c1, st.lane01 ^ c0, st.lane02 ^ c1, st.lane03 ^ c0, st.lane04, st.round_count)

pub fn keccak_chi_step(st: KeccakState) -> KeccakState:
    # Non-linear Chi mapping: a = a ^ ((~b) & c)
    let a0 = st.lane00 ^ (st.lane01 & st.lane02)
    let a1 = st.lane01 ^ (st.lane02 & st.lane03)
    KeccakState(a0, a1, st.lane02, st.lane03, st.lane04, st.round_count)

pub fn keccak_permute(st: KeccakState) -> KeccakState:
    let st1 = keccak_theta_step(st)
    keccak_chi_step(st1)

# ----------------------------------------------------------------------------
# 3. HMAC (Hash-based Message Authentication Code)
# ----------------------------------------------------------------------------

type HmacContext = struct:
    key_hash: String
    inner_pad: String
    outer_pad: String
    is_finalized: Bool

pub fn hmac_init(secret_key: String) -> HmacContext:
    let k_hash = crypto_sha256(secret_key)
    HmacContext(k_hash, "ipad_block_0x36", "opad_block_0x5c", false)

pub fn hmac_digest(ctx: HmacContext, message: String) -> String:
    let inner_msg = str_concat(ctx.inner_pad, message)
    let inner_hash = crypto_sha256(inner_msg)
    let outer_msg = str_concat(ctx.outer_pad, inner_hash)
    crypto_sha256(outer_msg)
