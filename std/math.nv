# Nova Standard Library: std/math.nova
# High-performance mathematical primitives and vector operations

type Vec2 = struct:
    x: Int
    y: Int

fn math_abs(x: Int) -> Int:
    if x < 0:
        0 - x
    else:
        x

fn math_min(a: Int, b: Int) -> Int:
    if a < b:
        a
    else:
        b

fn math_max(a: Int, b: Int) -> Int:
    if a > b:
        a
    else:
        b

fn math_clamp(v: Int, low: Int, high: Int) -> Int:
    if v < low:
        low
    elif v > high:
        high
    else:
        v

fn math_sqrt(x: Int) -> Int:
    nova_math_sqrt(x)

fn math_pow(base: Int, exp: Int) -> Int:
    nova_math_pow(base, exp)

fn math_gcd(a: Int, b: Int) -> Int:
    nova_math_gcd(a, b)

fn math_lcm(a: Int, b: Int) -> Int:
    nova_math_lcm(a, b)

fn vec2_new(x: Int, y: Int) -> Vec2:
    Vec2(x, y)

fn vec2_add(a: Vec2, b: Vec2) -> Vec2:
    Vec2(a.x + b.x, a.y + b.y)

fn vec2_sub(a: Vec2, b: Vec2) -> Vec2:
    Vec2(a.x - b.x, a.y - b.y)

fn vec2_dot(a: Vec2, b: Vec2) -> Int:
    (a.x * b.x) + (a.y * b.y)
