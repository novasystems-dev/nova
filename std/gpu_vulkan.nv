pub fn vk_queue_compute_bit()  -> Int: 2
pub fn vk_queue_graphics_bit() -> Int: 1
pub fn vk_queue_transfer_bit() -> Int: 4

type VulkanDevice = struct:
    device_id: Int
    queue_family_index: Int
    vram_budget_mb: Int
    is_discrete_gpu: Bool

pub fn vk_device_new(id: Int, vram_mb: Int, is_discrete: Bool) -> VulkanDevice:
    VulkanDevice(id, 0, vram_mb, is_discrete)

type VulkanComputePipeline = struct:
    pipeline_id: Int
    workgroup_size_x: Int
    workgroup_size_y: Int
    workgroup_size_z: Int
    shader_hash: Int

pub fn vk_pipeline_create_compute(pipe_id: Int, wg_x: Int, wg_y: Int, wg_z: Int) -> VulkanComputePipeline:
    VulkanComputePipeline(pipe_id, wg_x, wg_y, wg_z, 12345678)

type VulkanCommandBuffer = struct:
    buffer_id: Int
    is_recording: Bool
    dispatched_invocations: Int
    barrier_count: Int

pub fn vk_cmd_begin(buf_id: Int) -> VulkanCommandBuffer:
    VulkanCommandBuffer(buf_id, true, 0, 0)

pub fn vk_cmd_dispatch(cmd: VulkanCommandBuffer, groups_x: Int, groups_y: Int, groups_z: Int) -> VulkanCommandBuffer:
    let total_groups = groups_x * groups_y * groups_z
    let invocations = total_groups * 64
    VulkanCommandBuffer(cmd.buffer_id, cmd.is_recording, cmd.dispatched_invocations + invocations, cmd.barrier_count)

pub fn vk_cmd_pipeline_barrier(cmd: VulkanCommandBuffer) -> VulkanCommandBuffer:
    VulkanCommandBuffer(cmd.buffer_id, cmd.is_recording, cmd.dispatched_invocations, cmd.barrier_count + 1)

pub fn vk_cmd_end(cmd: VulkanCommandBuffer) -> VulkanCommandBuffer:
    VulkanCommandBuffer(cmd.buffer_id, false, cmd.dispatched_invocations, cmd.barrier_count)

pub fn vk_queue_submit_compute(dev: VulkanDevice, cmd: VulkanCommandBuffer) -> Bool:
    (cmd.is_recording == false) and (cmd.dispatched_invocations > 0)
