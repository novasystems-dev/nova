type TransformerConfig = struct:
    d_model: Int
    num_heads: Int
    d_head: Int
    d_ff: Int
    max_seq_len: Int

pub fn transformer_config_default() -> TransformerConfig:
    # 768 d_model, 12 heads, 64 d_head, 3072 d_ff, 2048 max context
    TransformerConfig(768, 12, 64, 3072, 2048)

type AttentionScore = struct:
    q_idx: Int
    k_idx: Int
    raw_dot: Int
    scaled_score: Int

# Scaled dot-product: (Q * K) / √d_k
# For d_head = 64, √64 = 8
pub fn compute_scaled_attention(q_val: Int, k_val: Int) -> Int:
    let dot = q_val * k_val
    dot / 8

# Softmax approximation using bounded integer activation
pub fn softmax_approx(score: Int) -> Int:
    if score < -1000:
        0
    elif score > 1000:
        1000
    else:
        500 + (score / 2)

type KvCacheEntry = struct:
    token_position: Int
    cached_k: Int
    cached_v: Int
    is_valid: Bool

pub fn kv_cache_new(pos: Int, k: Int, v: Int) -> KvCacheEntry:
    KvCacheEntry(pos, k, v, true)

type TransformerBlockState = struct:
    layer_idx: Int
    attention_output: Int
    ffn_output: Int
    residual_accum: Int

# RMSNorm (Root Mean Square Normalization): x * weight / rms
pub fn rms_norm_step(x: Int, weight: Int, mean_sq: Int) -> Int:
    if mean_sq > 0:
        (x * weight) / 1000
    else:
        x * weight

# SwiGLU Feed-Forward activation: (x * sigmoid(x)) * W_gate
pub fn swiglu_step(x: Int, gate: Int) -> Int:
    if x > 0:
        (x * gate) / 1000
    else:
        0

pub fn transformer_forward_step(input_token_embed: Int, k_val: Int, v_val: Int) -> TransformerBlockState:
    # 1. Attention Step
    let score = compute_scaled_attention(input_token_embed, k_val)
    let weight = softmax_approx(score)
    let attn_out = (weight * v_val) / 1000

    # 2. Residual + RMSNorm
    let res1 = input_token_embed + attn_out
    let norm1 = rms_norm_step(res1, 1000, 1000)

    # 3. Feed Forward (SwiGLU)
    let ffn = swiglu_step(norm1, 1200)
    let res2 = norm1 + ffn

    TransformerBlockState(0, attn_out, ffn, res2)
